# Vibrion Sentinel — cohort phylogenetics (genome-wide core SNPs)
#
# Consumes the per-sample masked consensus FASTAs the lite pipeline already
# produces (archived to R2 by sentinel-watch for QC-pass runs) and builds a
# core-SNP tree for a cohort.
#
# Why no MSA step: every consensus comes from mapping to the same reference
# at the same coordinates, so the sequences are already mutually aligned.
# Stacking them IS the alignment. (The older workflow/scripts/*phylogeny*
# scripts MAFFT-align concatenated surveillance loci instead -- ~46 kb of
# largely conserved genes, which for a clonal lineage yields almost no
# informative sites.)
#
#   snakemake -s workflow/cohort_phylo/Snakefile \
#       --config manifest=cohorts/backtest-2022.tsv consensus_dir=consensus \
#                outdir=results/cohort/backtest-2022 --cores 4

import os

MANIFEST = config["manifest"]
CONSENSUS_DIR = config["consensus_dir"]      # local dir of <ACC>.fasta[.gz]
OUTDIR = config["outdir"]
THREADS = config.get("threads", 4)

# Sites with more than this fraction of N across the cohort are dropped:
# consensus carries N wherever per-sample depth was below min_site_depth.
MAX_SITE_MISSING = config.get("max_site_missing", 0.10)
# Samples whose consensus is less complete than this are excluded outright.
MIN_SAMPLE_CALLED = config.get("min_sample_called", 0.80)
# Regions that distort a clonal tree (prophage/islands/repeats).
MASK_BED = config.get("mask_bed", f"{workflow.basedir}/phylo_exclude.bed")


def cohort_accessions(path):
    accs = []
    with open(path) as fh:
        for line in fh:
            if line.startswith("#") or not line.strip():
                continue
            parts = line.rstrip("\n").split("\t")
            if parts[0] == "run_accession":   # header
                continue
            accs.append(parts[0])
    return accs


ACCESSIONS = cohort_accessions(MANIFEST)


rule all:
    input:
        f"{OUTDIR}/tree.nwk",
        f"{OUTDIR}/snp_distances.tsv",
        f"{OUTDIR}/alignment_stats.json",


rule stack_alignment:
    """Stack reference-coordinate consensus sequences into one alignment,
    applying the exclusion mask and dropping high-missingness sites."""
    output:
        aln=f"{OUTDIR}/core_alignment.fasta",
        stats=f"{OUTDIR}/alignment_stats.json",
        dropped=f"{OUTDIR}/excluded_samples.tsv",
    run:
        import glob
        import gzip
        import json
        import os

        os.makedirs(OUTDIR, exist_ok=True)

        def read_consensus(acc):
            for pat in (f"{CONSENSUS_DIR}/{acc}.fasta.gz", f"{CONSENSUS_DIR}/{acc}.fasta"):
                if os.path.exists(pat):
                    op = gzip.open if pat.endswith(".gz") else open
                    seqs, name = {}, None
                    with op(pat, "rt") as fh:
                        for line in fh:
                            if line.startswith(">"):
                                name = line[1:].split()[0]
                                seqs[name] = []
                            elif name:
                                seqs[name].append(line.strip())
                    return {k: "".join(v) for k, v in seqs.items()}
            return None

        # exclusion mask -> set of 0-based positions per contig
        masked = {}
        if os.path.exists(MASK_BED):
            with open(MASK_BED) as fh:
                for line in fh:
                    if line.startswith("#") or not line.strip():
                        continue
                    p = line.split("\t")
                    masked.setdefault(p[0], []).append((int(p[1]), int(p[2])))

        loaded, excluded = {}, []
        for acc in ACCESSIONS:
            c = read_consensus(acc)
            if not c:
                excluded.append((acc, "no consensus available"))
                continue
            seq = "".join(c[k] for k in sorted(c))
            called = 1.0 - (seq.upper().count("N") / len(seq)) if seq else 0.0
            if called < MIN_SAMPLE_CALLED:
                excluded.append((acc, f"called {called:.3f} < {MIN_SAMPLE_CALLED}"))
                continue
            loaded[acc] = (c, called)

        if len(loaded) < 3:
            raise RuntimeError(
                f"only {len(loaded)} usable consensus sequences "
                f"({len(excluded)} excluded) -- need >=3 for a tree")

        contigs = sorted(next(iter(loaded.values()))[0])
        lengths = {ct: len(next(iter(loaded.values()))[0][ct]) for ct in contigs}
        for acc, (c, _) in loaded.items():
            for ct in contigs:
                if len(c.get(ct, "")) != lengths[ct]:
                    raise RuntimeError(
                        f"{acc} contig {ct} length {len(c.get(ct,''))} != "
                        f"{lengths[ct]}: consensus sequences are not on identical "
                        "reference coordinates, so stacking them is invalid")

        # mark masked positions per contig
        skip = {ct: bytearray(lengths[ct]) for ct in contigs}
        n_masked = 0
        for ct, ivs in masked.items():
            if ct not in skip:
                continue
            for s, e in ivs:
                for i in range(max(0, s), min(e, lengths[ct])):
                    if not skip[ct][i]:
                        skip[ct][i] = 1
                        n_masked += 1

        accs = sorted(loaded)
        cols = []           # variable, sufficiently-covered sites
        total_sites = 0
        n_missing_dropped = 0
        n_invariant = 0
        for ct in contigs:
            seqs = [loaded[a][0][ct].upper() for a in accs]
            for i in range(lengths[ct]):
                if skip[ct][i]:
                    continue
                total_sites += 1
                col = [s[i] for s in seqs]
                miss = sum(1 for b in col if b not in "ACGT")
                if miss / len(col) > MAX_SITE_MISSING:
                    n_missing_dropped += 1
                    continue
                if len({b for b in col if b in "ACGT"}) < 2:
                    n_invariant += 1
                    continue
                cols.append(col)

        with open(output.aln, "w") as out:
            for j, a in enumerate(accs):
                out.write(f">{a}\n")
                out.write("".join(c[j] for c in cols) + "\n")

        with open(output.dropped, "w") as out:
            out.write("accession\treason\n")
            for acc, why in excluded:
                out.write(f"{acc}\t{why}\n")

        stats = {
            "cohort_manifest": MANIFEST,
            "samples_in_manifest": len(ACCESSIONS),
            "samples_used": len(accs),
            "samples_excluded": len(excluded),
            "contigs": contigs,
            "reference_sites": sum(lengths.values()),
            "sites_masked_by_bed": n_masked,
            "sites_considered": total_sites,
            "sites_dropped_missing": n_missing_dropped,
            "sites_invariant": n_invariant,
            "variable_sites": len(cols),
            "max_site_missing": MAX_SITE_MISSING,
            "min_sample_called": MIN_SAMPLE_CALLED,
        }
        with open(output.stats, "w") as out:
            json.dump(stats, out, indent=2)
        print(json.dumps(stats, indent=2))

        # A clonal cohort still yields tens of SNPs; near-zero means the
        # method is wrong (too little sequence, or over-masking), not that
        # the isolates are identical. Fail loudly rather than emit a tree
        # built from noise.
        if len(cols) < 5:
            raise RuntimeError(
                f"only {len(cols)} variable sites across {len(accs)} samples -- "
                "too few for a meaningful tree; check masking and coverage")


rule snp_distances:
    input:
        aln=rules.stack_alignment.output.aln,
    output:
        tsv=f"{OUTDIR}/snp_distances.tsv",
    run:
        seqs, name = {}, None
        with open(input.aln) as fh:
            for line in fh:
                if line.startswith(">"):
                    name = line[1:].strip()
                    seqs[name] = ""
                else:
                    seqs[name] += line.strip()
        accs = sorted(seqs)
        with open(output.tsv, "w") as out:
            out.write("\t" + "\t".join(accs) + "\n")
            for a in accs:
                row = [a]
                for b in accs:
                    d = sum(
                        1
                        for x, y in zip(seqs[a], seqs[b])
                        if x in "ACGT" and y in "ACGT" and x != y
                    )
                    row.append(str(d))
                out.write("\t".join(row) + "\n")


rule tree:
    """ML tree with ascertainment-bias correction: the alignment is
    SNP-only, so invariant sites must be accounted for (+ASC) or branch
    lengths are inflated."""
    input:
        aln=rules.stack_alignment.output.aln,
    output:
        nwk=f"{OUTDIR}/tree.nwk",
    log:
        f"{OUTDIR}/iqtree.log",
    threads: THREADS
    shell:
        """
        set -euo pipefail
        # bioconda ships iqtree2 or iqtree3 depending on version; resolve it
        IQ=""
        for c in iqtree3 iqtree2 iqtree; do
            command -v "$c" >/dev/null 2>&1 && {{ IQ="$c"; break; }}
        done
        [ -n "$IQ" ] || {{ echo "no iqtree binary found" >&2; exit 1; }}
        echo "using $IQ" > {log}
        "$IQ" -s {input.aln} -m GTR+ASC -nt {threads} \
            -pre {OUTDIR}/iqtree -redo >> {log} 2>&1
        cp {OUTDIR}/iqtree.treefile {output.nwk}
        """
