# Vibrion Sentinel — lite per-sample pipeline (GitHub Actions tier)
#
# Balanced-tier core: QC -> Haiti kraken2 classification -> Vibrio read
# extraction -> BWA mapping vs 7PET reference -> variant calling ->
# surveillance-loci coverage -> JSON report.
#
# Runs inside the single `sentinel_lite` conda env (tools on PATH).
# The GitHub workflow writes config.yaml per accession before invoking:
#   snakemake -s workflow/sentinel_lite/Snakefile --configfile work/<ACC>/config.yaml --cores 2

configfile: "work/config.yaml"  # overridden by --configfile

ACC = config["accession"]
REFDIR = config["refdir"]
OUTDIR = config["outdir"]
PAIRED = config.get("paired", True)
THREADS = config.get("threads", 2)

# QC thresholds. Provisional defaults: no organism-specific published
# standard was found for V. cholerae mapping QC; tune against known-good runs.
MIN_SITE_DEPTH = config.get("min_site_depth", 10)        # per-position: below -> N in consensus, no variant call
QC_MIN_MEAN_DEPTH = config.get("qc_min_mean_depth", 20)  # genome-wide mean depth
QC_MIN_CALLED_PCT = config.get("qc_min_called_pct", 90)  # % of reference called (not masked)
LOCUS_PRESENT_BREADTH = config.get("locus_present_breadth", 80)  # % of locus with >= 1 read
LOCUS_ABSENT_BREADTH = config.get("locus_absent_breadth", 20)
QC_MIN_SPECIES_PURITY = config.get("qc_min_species_purity", 90)  # % of kraken-processed reads classified as V. cholerae

REF = f"{REFDIR}/2010EL-1786.fasta"
KRAKEN_DB = f"{REFDIR}/kraken2_haiti_custom"
# curated, versioned with the code (not the reference bundle); see file header
LOCI_BED = config.get("loci_bed", f"{workflow.basedir}/loci_2010EL-1786.bed")


rule all:
    input:
        f"{OUTDIR}/report.json",


rule fastp_qc:
    input:
        r1=config["reads_r1"],
        r2=config["reads_r2"] if PAIRED else [],
    output:
        r1=f"{OUTDIR}/01_qc/cleaned_1.fastq.gz",
        r2=f"{OUTDIR}/01_qc/cleaned_2.fastq.gz",
        json=f"{OUTDIR}/01_qc/fastp.json",
        html=f"{OUTDIR}/01_qc/fastp.html",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/01_qc
        if [ "{PAIRED}" = "True" ]; then
            fastp -i {input.r1} -I {input.r2} \
                -o {output.r1} -O {output.r2} \
                -j {output.json} -h {output.html} \
                -w {threads} --detect_adapter_for_pe \
                2> {OUTDIR}/01_qc/fastp.log
        else
            fastp -i {input.r1} \
                -o {output.r1} \
                -j {output.json} -h {output.html} \
                -w {threads} \
                2> {OUTDIR}/01_qc/fastp.log
            touch {output.r2}
        fi
        """


rule kraken2_classify:
    input:
        r1=rules.fastp_qc.output.r1,
        r2=rules.fastp_qc.output.r2,
    output:
        out=f"{OUTDIR}/02_kraken/kraken.out",
        report=f"{OUTDIR}/02_kraken/kraken.report",
    params:
        paired_arg="--paired" if PAIRED else "",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/02_kraken
        if [ "{PAIRED}" = "True" ]; then
            kraken2 --db {KRAKEN_DB} --threads {threads} --paired \
                --output {output.out} --report {output.report} \
                {input.r1} {input.r2} 2> {OUTDIR}/02_kraken/kraken.log
        else
            kraken2 --db {KRAKEN_DB} --threads {threads} \
                --output {output.out} --report {output.report} \
                {input.r1} 2> {OUTDIR}/02_kraken/kraken.log
        fi
        """


rule extract_vibrio:
    """Keep reads classified as V. cholerae (taxid 666) or unclassified.

    Kraken is the coarse filter; BWA mapping to the cholerae reference
    downstream is the confirmatory step, so unclassified reads are kept
    to rescue divergent strains.
    """
    input:
        kraken=rules.kraken2_classify.output.out,
        r1=rules.fastp_qc.output.r1,
        r2=rules.fastp_qc.output.r2,
    output:
        r1=f"{OUTDIR}/03_vibrio/vibrio_1.fastq.gz",
        r2=f"{OUTDIR}/03_vibrio/vibrio_2.fastq.gz",
        stats=f"{OUTDIR}/03_vibrio/extraction_stats.json",
    run:
        import gzip, json

        CHOLERAE_TAXID = "666"
        keep = set()  # read ids (without /1 /2 suffix)
        n_class, n_keep = 0, 0
        with open(input.kraken) as fh:
            for line in fh:
                parts = line.split("\t")
                if len(parts) < 3:
                    continue
                status, rid, taxid = parts[0], parts[1], parts[2]
                n_class += 1
                base = rid.rsplit("/", 1)[0] if "/" in rid else rid
                if status == "C" and taxid == CHOLERAE_TAXID:
                    keep.add(base)
                    n_keep += 1
                elif status == "U":
                    keep.add(base)
                    n_keep += 1

        def filtered(in_path, out_path, suffix):
            n_in, n_out = 0, 0
            with gzip.open(in_path, "rt") as fin, gzip.open(out_path, "wt") as fout:
                while True:
                    h = fin.readline()
                    if not h:
                        break
                    seq, plus, qual = fin.readline(), fin.readline(), fin.readline()
                    n_in += 1
                    base = h[1:].split()[0].rsplit("/", 1)[0]
                    if base in keep:
                        fout.write(h + seq + plus + qual)
                        n_out += 1
            return n_in, n_out

        import os
        os.makedirs(f"{OUTDIR}/03_vibrio", exist_ok=True)
        i1, o1 = filtered(input.r1, output.r1, "1")
        if PAIRED:
            i2, o2 = filtered(input.r2, output.r2, "2")
        else:
            open(output.r2, "wb").close()  # placeholder; downstream skips R2
            i2, o2 = 0, 0

        with open(output.stats, "w") as f:
            json.dump({
                "kraken_classified": n_class,
                "kept_for_mapping": n_keep,
                "r1_in": i1, "r1_kept": o1,
                "r2_in": i2, "r2_kept": o2,
                "paired": PAIRED,
            }, f, indent=2)


rule bwa_map:
    input:
        r1=rules.extract_vibrio.output.r1,
        r2=rules.extract_vibrio.output.r2,
    output:
        bam=f"{OUTDIR}/04_map/mapped.bam",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/04_map
        if [ "{PAIRED}" = "True" ]; then
            bwa mem -t {threads} {REF} {input.r1} {input.r2} 2> {OUTDIR}/04_map/bwa.log \
                | samtools sort -@ {threads} -o {output.bam}
        else
            bwa mem -t {threads} {REF} {input.r1} 2> {OUTDIR}/04_map/bwa.log \
                | samtools sort -@ {threads} -o {output.bam}
        fi
        samtools index {output.bam}
        """


rule coverage_stats:
    input:
        bam=rules.bwa_map.output.bam,
    output:
        cov=f"{OUTDIR}/04_map/coverage.txt",
        flag=f"{OUTDIR}/04_map/flagstat.txt",
    shell:
        """
        samtools coverage {input.bam} > {output.cov} 2>/dev/null
        samtools flagstat {input.bam} > {output.flag}
        """


rule loci_coverage:
    input:
        bam=rules.bwa_map.output.bam,
    output:
        txt=f"{OUTDIR}/05_loci/loci_coverage.txt",
    run:
        # Per-locus coverage via `samtools coverage -r` (samtools coverage
        # has no BED input mode). Output keeps the samtools-coverage table
        # format the report rule parses.
        import os
        import subprocess

        os.makedirs(f"{OUTDIR}/05_loci", exist_ok=True)
        header = ("#rname\tstartpos\tendpos\tnumreads\tcovbases\t"
                  "coverage\tmeandepth\tmeanbaseq\tmeanmapq\n")
        rows = []
        with open(LOCI_BED) as fh:
            for line in fh:
                if not line.strip() or line.startswith("#"):
                    continue
                p = line.rstrip("\n").split("\t")
                region = f"{p[0]}:{int(p[1]) + 1}-{p[2]}"
                r = subprocess.run(
                    ["samtools", "coverage", "-r", region, input.bam],
                    capture_output=True, text=True)
                for ln in r.stdout.splitlines():
                    if ln.startswith("#rname") or not ln.strip():
                        continue
                    rows.append(ln)
        with open(output.txt, "w") as out:
            out.write(header)
            for ln in rows:
                out.write(ln + "\n")


rule call_variants:
    """Haploid calling (V. cholerae is haploid; bcftools defaults to diploid),
    then keep only sites with QUAL >= 30 and depth >= MIN_SITE_DEPTH."""
    input:
        bam=rules.bwa_map.output.bam,
    output:
        raw=f"{OUTDIR}/06_variants/variants.raw.vcf.gz",
        vcf=f"{OUTDIR}/06_variants/variants.vcf.gz",
        snp_count=f"{OUTDIR}/06_variants/snp_count.txt",
    log:
        f"{OUTDIR}/06_variants/bcftools.log",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/06_variants
        bcftools mpileup -f {REF} --threads {threads} -q 20 -Q 20 \
            {input.bam} 2> {log} | \
            bcftools call --ploidy 1 -mv -Oz --threads {threads} \
            -o {output.raw} 2>> {log}
        bcftools filter -i 'QUAL>=30 && INFO/DP>={MIN_SITE_DEPTH}' \
            -Oz -o {output.vcf} {output.raw} 2>> {log}
        bcftools index -f {output.vcf} 2>> {log}
        bcftools view -H -v snps {output.vcf} | wc -l > {output.snp_count}
        """


rule depth_mask:
    """BED of positions with depth < MIN_SITE_DEPTH (incl. contigs with no
    reads at all), masked to N in the consensus so uncovered sequence is
    never reported as the reference base."""
    input:
        bam=rules.bwa_map.output.bam,
    output:
        bed=f"{OUTDIR}/06_variants/low_depth_mask.bed",
    shell:
        """
        samtools depth -aa -q 20 -Q 20 {input.bam} | \
            awk -v m={MIN_SITE_DEPTH} 'BEGIN{{OFS="\\t"}}
                $3 < m {{
                    if ($1 == c && $2 == e + 1) {{ e = $2 }}
                    else {{ if (c != "") print c, s - 1, e; c = $1; s = $2; e = $2 }}
                    next
                }}
                {{ if (c != "") print c, s - 1, e; c = "" }}
                END {{ if (c != "") print c, s - 1, e }}' > {output.bed}
        """


rule consensus:
    input:
        vcf=rules.call_variants.output.vcf,
        mask=rules.depth_mask.output.bed,
    output:
        fa=f"{OUTDIR}/06_variants/consensus.fasta",
    log:
        f"{OUTDIR}/06_variants/consensus.log",
    shell:
        """
        bcftools consensus -f {REF} -m {input.mask} {input.vcf} \
            > {output.fa} 2> {log}
        """


rule report:
    input:
        fastp_json=rules.fastp_qc.output.json,
        kraken_report=rules.kraken2_classify.output.report,
        extract_stats=rules.extract_vibrio.output.stats,
        coverage=rules.coverage_stats.output.cov,
        flagstat=rules.coverage_stats.output.flag,
        loci=rules.loci_coverage.output.txt,
        loci_bed=LOCI_BED,
        snp_count=rules.call_variants.output.snp_count,
        consensus=rules.consensus.output.fa,
    output:
        json=f"{OUTDIR}/report.json",
    run:
        import json as _json, os, re, subprocess

        def load_json(p):
            with open(p) as f:
                return _json.load(f)

        fp = load_json(input.fastp_json)
        before = fp["summary"]["before_filtering"]["total_reads"]
        after = fp["summary"]["after_filtering"]["total_reads"]

        # kraken: V. cholerae (taxid 666) fraction from report.
        # Columns: pct, clade_reads, direct_reads, rank_code, taxid, name.
        # Total reads Kraken actually processed = unclassified (taxid "0")
        # clade count + root (taxid "1") clade count (root's clade count is
        # every classified read). The previous max(clade_reads) over all
        # rows picked whichever of those two happened to be larger, which
        # is not the total and made this fraction meaningless regardless of
        # how many species the DB could tell apart.
        cholerae_reads, unclassified_reads, root_reads = 0, 0, 0
        with open(input.kraken_report) as f:
            for line in f:
                parts = line.strip().split("\t")
                if len(parts) >= 6:
                    n_reads, taxid = parts[1], parts[4]
                    try:
                        n_reads = int(n_reads)
                    except ValueError:
                        continue
                    if taxid == "666":
                        cholerae_reads = n_reads
                    elif taxid == "0":
                        unclassified_reads = n_reads
                    elif taxid == "1":
                        root_reads = n_reads
        total_kraken = unclassified_reads + root_reads

        ex = load_json(input.extract_stats)

        # genome-wide coverage: length-weighted over all contigs (chr1 + chr2)
        # from samtools coverage rows (startpos, endpos, covbases, meandepth)
        tot_len, tot_cov, depth_sum = 0, 0, 0.0
        with open(input.coverage) as f:
            for line in f:
                if line.startswith("#rname"):
                    continue
                p = line.strip().split("\t")
                if len(p) >= 7:
                    try:
                        length = int(p[2]) - int(p[1]) + 1
                        tot_len += length
                        tot_cov += int(p[4])
                        depth_sum += float(p[6]) * length
                    except ValueError:
                        pass
        mean_depth = depth_sum / tot_len if tot_len else 0.0
        breadth = 100.0 * tot_cov / tot_len if tot_len else 0.0

        mapped = 0
        m = re.search(r"(\d+) \+ \d+ mapped", open(input.flagstat).read())
        if m:
            mapped = int(m.group(1))

        # loci presence: match BED intervals by coordinates (samtools coverage
        # -r prints rname/startpos/endpos, not the BED name). Called on
        # breadth (% of locus with >= 1 read), not depth: AT-rich loci (toxT
        # is ~28% GC vs 47.5% genome) get low Illumina depth while present.
        # Depth is reported for information. Only meaningful if qc passes.
        bed_labels = {}
        with open(input.loci_bed) as f:
            for line in f:
                if not line.strip() or line.startswith("#"):
                    continue
                p = line.strip().split("\t")
                # BED is 0-based; samtools coverage startpos is 1-based
                bed_labels[(p[0], int(p[1]) + 1, int(p[2]))] = p[3]
        loci_calls = {}
        with open(input.loci) as f:
            for line in f:
                if line.startswith("#rname") or not line.strip() or "failed" in line:
                    continue
                p = line.strip().split("\t")
                if len(p) >= 7:
                    try:
                        key = (p[0], int(p[1]), int(p[2]))
                        depth, cov = float(p[6]), float(p[5])
                    except ValueError:
                        continue
                    name = bed_labels.get(key, f"{p[0]}:{p[1]}-{p[2]}")
                    if cov >= LOCUS_PRESENT_BREADTH:
                        call = "present"
                    elif cov < LOCUS_ABSENT_BREADTH:
                        call = "absent"
                    else:
                        call = "partial"  # truncated, divergent, or low coverage
                    loci_calls[name] = {
                        "call": call,
                        "present": call == "present",
                        "mean_depth": round(depth, 2),
                        "breadth_pct": round(cov, 2),
                    }

        try:
            snps = int(open(input.snp_count).read().strip())
        except ValueError:
            snps = 0

        cons_len, cons_n = 0, 0
        with open(input.consensus) as f:
            for line in f:
                if not line.startswith(">"):
                    seq = line.strip()
                    cons_len += len(seq)
                    cons_n += seq.upper().count("N")
        called_pct = 100.0 * (cons_len - cons_n) / cons_len if cons_len else 0.0

        # QC gate: a failing run still gets a report (for inspection), but its
        # variants/consensus/loci calls must not be treated as results.
        v_cholerae_fraction = cholerae_reads / total_kraken if total_kraken else 0.0
        species_purity_pct = 100.0 * v_cholerae_fraction

        qc_reasons = []
        if mean_depth < QC_MIN_MEAN_DEPTH:
            qc_reasons.append(f"mean_depth {mean_depth:.2f} < {QC_MIN_MEAN_DEPTH}")
        if called_pct < QC_MIN_CALLED_PCT:
            qc_reasons.append(f"called_pct {called_pct:.2f} < {QC_MIN_CALLED_PCT}")
        if species_purity_pct < QC_MIN_SPECIES_PURITY:
            qc_reasons.append(f"species_purity {species_purity_pct:.2f} < {QC_MIN_SPECIES_PURITY}")

        report = {
            "pipeline": "vibrion-sentinel-lite",
            "version": "0.1.0",
            "accession": ACC,
            "reference": "2010EL-1786 (7PET, CP003069.1/CP003070.1)",
            "reads": {
                "raw": before,
                "qc_passed": after,
                "vibrio_kept": ex["kept_for_mapping"],
            },
            "classification": {
                "kraken_db": "kraken2_haiti_custom",
                "v_cholerae_reads": cholerae_reads,
                "v_cholerae_fraction": round(v_cholerae_fraction, 4),
            },
            "mapping": {
                "mapped_reads": mapped,
                "mean_depth": round(mean_depth, 2),
                "breadth_pct": round(breadth, 2),
            },
            "variants": {"snps_vs_7pet": snps},
            "surveillance_loci": loci_calls,
            "consensus_length": cons_len,
            "consensus_called_pct": round(called_pct, 2),
            "qc": {
                "status": "fail" if qc_reasons else "pass",
                "reasons": qc_reasons,
                "thresholds": {
                    "locus_present_breadth": LOCUS_PRESENT_BREADTH,
                    "locus_absent_breadth": LOCUS_ABSENT_BREADTH,
                    "min_site_depth": MIN_SITE_DEPTH,
                    "min_mean_depth": QC_MIN_MEAN_DEPTH,
                    "min_called_pct": QC_MIN_CALLED_PCT,
                    "min_species_purity": QC_MIN_SPECIES_PURITY,
                },
            },
            "notes": "Lite tier: mapping-based, no de novo assembly. "
                     "Consensus positions below min_site_depth are N. "
                     "If qc.status is 'fail', variants, consensus and loci "
                     "calls are not interpretable. Loci BED is provisional "
                     "and does not yet support serogroup/biotype calls.",
        }
        os.makedirs(OUTDIR, exist_ok=True)
        with open(output.json, "w") as f:
            _json.dump(report, f, indent=2)
        print(_json.dumps(report, indent=2)[:2000])
