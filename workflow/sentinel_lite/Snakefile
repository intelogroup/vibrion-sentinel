# Vibrion Sentinel — lite per-sample pipeline (GitHub Actions tier)
#
# Phase 0 (Nanopore branch): two tiers, platform-dispatched at parse time.
#
#   Tier lite     — mapping-based QC -> Haiti kraken2 classification -> Vibrio
#                   read extraction -> mapping vs 7PET reference -> variant
#                   calling -> surveillance-loci coverage -> JSON report.
#                   Works for Illumina (bwa mem) and Nanopore (minimap2 map-ont).
#   Tier assembly — Nanopore only: Flye assembly -> Medaka polish -> assembly QC
#                   gate -> MLST -> vibecheck lineage -> AMRFinderPlus -> report.
#                   A failing assembly QC gate suppresses all lineage/AMR calls.
#
# Config (per accession, written by the GitHub workflow or future upload API):
#   platform:         illumina | nanopore          (default: illumina)
#   basecaller_model: fast | hac | sup             (REQUIRED for nanopore; fail-closed)
#   tier:             lite | assembly              (default: lite; assembly is nanopore-only)
#
# Decision record: Snakemake is extended, not replaced, in Phase 0. A Nextflow
# migration reopens only if Phase 1 job orchestration forces it.
#
# Runs inside the single `sentinel_lite` conda env (tools on PATH).
# The GitHub workflow writes config.yaml per accession before invoking:
#   snakemake -s workflow/sentinel_lite/Snakefile --configfile work/<ACC>/config.yaml --cores 2

configfile: "work/config.yaml"  # overridden by --configfile

import sys as _sys
_sys.path.insert(0, workflow.basedir)
import report_lib
import vibrio_extract_lib
import loci_coverage_lib
import nano_qc_lib

ACC = config["accession"]
REFDIR = config["refdir"]
OUTDIR = config["outdir"]
THREADS = config.get("threads", 2)

# Platform / tier dispatch. Fail-closed: nanopore without basecaller_model
# refuses to run (Medaka models are basecaller-matched; a wrong model is a
# silent accuracy killer). See report_lib.validate_platform_config.
PLATFORM, BASECALLER_MODEL, TIER = report_lib.validate_platform_config(config)

# Nanopore reads are single-end by construction.
PAIRED = config.get("paired", True)
if PLATFORM == "nanopore":
    PAIRED = False

# QC thresholds: platform defaults, explicit config values win.
_QC = report_lib.platform_qc_thresholds(config, PLATFORM)
MIN_SITE_DEPTH = _QC["min_site_depth"]        # per-position: below -> N in consensus, no variant call
QC_MIN_MEAN_DEPTH = _QC["qc_min_mean_depth"]  # genome-wide mean depth
QC_MIN_CALLED_PCT = _QC["qc_min_called_pct"]  # % of reference called (not masked)
LOCUS_PRESENT_BREADTH = config.get("locus_present_breadth", 80)  # % of locus with >= 1 read
LOCUS_ABSENT_BREADTH = config.get("locus_absent_breadth", 20)
QC_MIN_SPECIES_PURITY = _QC["qc_min_species_purity"]  # % of kraken-processed reads classified as V. cholerae
# Hard-fail floors (tiered QC gates): extreme contamination or <50% breadth
# excludes the sample from all outputs. Provisional cutoffs above only flag.
QC_HARD_MIN_CALLED_PCT = _QC["qc_hard_min_called_pct"]
QC_HARD_MIN_SPECIES_PURITY = _QC["qc_hard_min_species_purity"]

REF = f"{REFDIR}/2010EL-1786.fasta"
KRAKEN_DB = f"{REFDIR}/kraken2_haiti_custom"
# curated, versioned with the code (not the reference bundle); see file header
LOCI_BED = config.get("loci_bed", f"{workflow.basedir}/loci_2010EL-1786.bed")
# Phase 5B: ICE structural segments, curated allele table, mobile elements.
ICE_BED = f"{workflow.basedir}/ice_segments.bed"
ALLELES_YAML = f"{workflow.basedir}/alleles.yaml"
MOBILE_MANIFEST = config.get(
    "mobile_elements_manifest", f"{workflow.basedir}/mobile_elements.yaml")
# Fail-closed: a malformed manifest breaks the run instead of silently
# skipping screens.
_MOBILE_ELEMENTS = report_lib.load_mobile_elements(MOBILE_MANIFEST)


rule all:
    input:
        f"{OUTDIR}/report.json",


# --------------------------------------------------------------------------
# Read QC (platform-dispatched)
# --------------------------------------------------------------------------

rule fastp_qc:
    """Illumina read QC. Skipped entirely for platform=nanopore."""
    input:
        r1=config["reads_r1"],
        r2=config["reads_r2"] if PAIRED else [],
    output:
        r1=f"{OUTDIR}/01_qc/cleaned_1.fastq.gz",
        r2=f"{OUTDIR}/01_qc/cleaned_2.fastq.gz",
        json=f"{OUTDIR}/01_qc/fastp.json",
        html=f"{OUTDIR}/01_qc/fastp.html",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/01_qc
        if [ "{PAIRED}" = "True" ]; then
            fastp -i {input.r1} -I {input.r2} \\
                -o {output.r1} -O {output.r2} \\
                -j {output.json} -h {output.html} \\
                -w {threads} --detect_adapter_for_pe \\
                2> {OUTDIR}/01_qc/fastp.log
        else
            fastp -i {input.r1} \\
                -o {output.r1} \\
                -j {output.json} -h {output.html} \\
                -w {threads} \\
                2> {OUTDIR}/01_qc/fastp.log
            touch {output.r2}
        fi
        """


rule nanoplot_qc:
    """Nanopore read QC stats (NanoPlot). Skipped for platform=illumina."""
    input:
        reads=config["reads_r1"],
    output:
        stats=f"{OUTDIR}/01_qc/nanoplot/NanoStats.txt",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/01_qc/nanoplot
        NanoPlot --fastq {input.reads} -o {OUTDIR}/01_qc/nanoplot \\
            --threads {threads} --no_static 2> {OUTDIR}/01_qc/nanoplot.log
        """


rule nanofilt_filter:
    """Nanopore read filtering with chopper (the maintained NanoFilt
    successor): Q>=9, length>=1000. Writes a fastp-shaped summary JSON via
    nano_qc_lib so the report rule stays platform-agnostic."""
    input:
        reads=config["reads_r1"],
        stats=rules.nanoplot_qc.output.stats,
    output:
        r1=f"{OUTDIR}/01_qc/cleaned.fastq.gz",
        r2=f"{OUTDIR}/01_qc/cleaned_2.fastq.gz",  # empty placeholder (single-end)
        summary=f"{OUTDIR}/01_qc/qc_summary.json",
    threads: THREADS
    run:
        import subprocess

        subprocess.run(
            f"chopper -q 9 -l 1000 -t {THREADS} -i {input.reads} "
            f"2> {OUTDIR}/01_qc/chopper.log | pigz -p {THREADS} > {output.r1}",
            shell=True,
            check=True,
        )
        # single-end placeholder, mirroring extract_vibrio's convention
        open(output.r2, "wb").close()
        nano_qc_lib.write_qc_summary(input.stats, output.r1, output.summary)


# Platform dispatch for everything downstream of read QC. Resolved at parse
# time (PLATFORM is fixed per config); only the selected branch enters the DAG.
if PLATFORM == "nanopore":
    _QC_R1 = rules.nanofilt_filter.output.r1
    _QC_R2 = rules.nanofilt_filter.output.r2
    _QC_SUMMARY = rules.nanofilt_filter.output.summary
else:
    _QC_R1 = rules.fastp_qc.output.r1
    _QC_R2 = rules.fastp_qc.output.r2
    _QC_SUMMARY = rules.fastp_qc.output.json


rule kraken2_classify:
    input:
        r1=_QC_R1,
        r2=_QC_R2,
    output:
        out=f"{OUTDIR}/02_kraken/kraken.out",
        report=f"{OUTDIR}/02_kraken/kraken.report",
    params:
        paired_arg="--paired" if PAIRED else "",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/02_kraken
        if [ "{PAIRED}" = "True" ]; then
            kraken2 --db {KRAKEN_DB} --threads {threads} --paired \\
                --output {output.out} --report {output.report} \\
                {input.r1} {input.r2} 2> {OUTDIR}/02_kraken/kraken.log
        else:
            kraken2 --db {KRAKEN_DB} --threads {threads} \\
                --output {output.out} --report {output.report} \\
                {input.r1} 2> {OUTDIR}/02_kraken/kraken.log
        fi
        """


rule extract_vibrio:
    """Keep reads classified as V. cholerae (taxid 666) or unclassified.

    Kraken is the coarse filter; mapping to the cholerae reference
    downstream is the confirmatory step, so unclassified reads are kept
    to rescue divergent strains.
    """
    input:
        kraken=rules.kraken2_classify.output.out,
        r1=_QC_R1,
        r2=_QC_R2,
    output:
        r1=f"{OUTDIR}/03_vibrio/vibrio_1.fastq.gz",
        r2=f"{OUTDIR}/03_vibrio/vibrio_2.fastq.gz",
        stats=f"{OUTDIR}/03_vibrio/extraction_stats.json",
    run:
        import json, os

        keep, n_class, n_keep = vibrio_extract_lib.build_keep_set(input.kraken)

        os.makedirs(f"{OUTDIR}/03_vibrio", exist_ok=True)
        i1, o1 = vibrio_extract_lib.filter_fastq(input.r1, output.r1, keep)
        if PAIRED:
            i2, o2 = vibrio_extract_lib.filter_fastq(input.r2, output.r2, keep)
        else:
            open(output.r2, "wb").close()  # placeholder; downstream skips R2
            i2, o2 = 0, 0

        with open(output.stats, "w") as f:
            json.dump({
                "kraken_classified": n_class,
                "kept_for_mapping": n_keep,
                "r1_in": i1, "r1_kept": o1,
                "r2_in": i2, "r2_kept": o2,
                "paired": PAIRED,
            }, f, indent=2)


rule bwa_map:
    """Illumina mapping vs 7PET reference (bwa-mem2, the maintained bwa
    successor). Skipped for platform=nanopore.

    NOTE: bwa-mem2 uses its own index format -- the reference bundle must be
    built with `bwa-mem2 index` (see .github/workflows/build-references.yml),
    not `bwa index`.
    """
    input:
        r1=rules.extract_vibrio.output.r1,
        r2=rules.extract_vibrio.output.r2,
    output:
        bam=f"{OUTDIR}/04_map/mapped.bam",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/04_map
        if [ "{PAIRED}" = "True" ]; then
            bwa-mem2 mem -t {threads} {REF} {input.r1} {input.r2} 2> {OUTDIR}/04_map/bwa-mem2.log \\
                | samtools sort -@ {threads} -o {output.bam}
        else:
            bwa-mem2 mem -t {threads} {REF} {input.r1} 2> {OUTDIR}/04_map/bwa-mem2.log \\
                | samtools sort -@ {threads} -o {output.bam}
        fi
        samtools index {output.bam}
        """


rule minimap2_map:
    """Nanopore mapping vs 7PET reference (minimap2 map-ont).
    Skipped for platform=illumina."""
    input:
        r1=rules.extract_vibrio.output.r1,
    output:
        bam=f"{OUTDIR}/04_map_ont/mapped.bam",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/04_map_ont
        minimap2 -ax map-ont -t {threads} {REF} {input.r1} \\
            2> {OUTDIR}/04_map_ont/minimap2.log \\
            | samtools sort -@ {threads} -o {output.bam}
        samtools index {output.bam}
        """


# BAM-level dispatch: everything downstream is platform-agnostic ("BAM is BAM").
_MAP_BAM = rules.minimap2_map.output.bam if PLATFORM == "nanopore" else rules.bwa_map.output.bam


rule coverage_stats:
    input:
        bam=_MAP_BAM,
    output:
        cov=f"{OUTDIR}/04_map/coverage.txt",
        flag=f"{OUTDIR}/04_map/flagstat.txt",
    shell:
        """
        samtools coverage {input.bam} > {output.cov} 2>/dev/null
        samtools flagstat {input.bam} > {output.flag}
        """


rule loci_coverage:
    input:
        bam=_MAP_BAM,
    output:
        txt=f"{OUTDIR}/05_loci/loci_coverage.txt",
    run:
        # Per-locus coverage via `samtools coverage -r` (samtools coverage
        # has no BED input mode). Output keeps the samtools-coverage table
        # format the report rule parses.
        import os
        import subprocess

        os.makedirs(f"{OUTDIR}/05_loci", exist_ok=True)
        header = ("#rname\tstartpos\tendpos\tnumreads\tcovbases\t"
                  "coverage\tmeandepth\tmeanbaseq\tmeanmapq\n")
        rows = []
        for _bed_fields, region in loci_coverage_lib.iter_bed_regions(LOCI_BED):
            r = subprocess.run(
                ["samtools", "coverage", "-r", region, input.bam],
                capture_output=True, text=True)
            for ln in r.stdout.splitlines():
                if ln.startswith("#rname") or not ln.strip():
                    continue
                rows.append(ln)
        with open(output.txt, "w") as out:
            out.write(header)
            for ln in rows:
                out.write(ln + "\n")


rule ice_segments:
    """Phase 5B.6: per-segment coverage of the SXT/R391 ICE for structural
    profiling (report_lib.profile_ice_segments). Same samtools-coverage
    table format as loci_coverage."""
    input:
        bam=_MAP_BAM,
    output:
        txt=f"{OUTDIR}/05_loci/ice_segments.txt",
    run:
        import os
        import subprocess

        os.makedirs(f"{OUTDIR}/05_loci", exist_ok=True)
        header = ("#rname\tstartpos\tendpos\tnumreads\tcovbases\t"
                  "coverage\tmeandepth\tmeanbaseq\tmeanmapq\n")
        rows = []
        for _bed_fields, region in loci_coverage_lib.iter_bed_regions(ICE_BED):
            r = subprocess.run(
                ["samtools", "coverage", "-r", region, input.bam],
                capture_output=True, text=True)
            for ln in r.stdout.splitlines():
                if ln.startswith("#rname") or not ln.strip():
                    continue
                rows.append(ln)
        with open(output.txt, "w") as out:
            out.write(header)
            for ln in rows:
                out.write(ln + "\n")


if _MOBILE_ELEMENTS:
    # Phase 5B.3/5B.4: coverage screen of extracted Vibrio reads against
    # versioned mobile-element references (PLE islands, anti-phage defense
    # systems). Only defined when the manifest lists elements; an empty
    # manifest (default) skips this entirely and the report records
    # mobile_elements as not_screened.
    rule mobile_element_screen:
        input:
            r1=rules.extract_vibrio.output.r1,
            r2=rules.extract_vibrio.output.r2,
        output:
            tsv=f"{OUTDIR}/08_mobile/mobile_elements.tsv",
        threads: THREADS
        run:
            import os
            import subprocess

            os.makedirs(f"{OUTDIR}/08_mobile", exist_ok=True)
            with open(output.tsv, "w") as out:
                out.write("element\tbreadth_pct\tmean_depth\tcitation\n")
                for el in _MOBILE_ELEMENTS:
                    ref = el["ref_fasta"]
                    bam = f"{OUTDIR}/08_mobile/{el['id']}.bam"
                    if PLATFORM == "nanopore":
                        map_cmd = (
                            f"minimap2 -t {THREADS} -ax map-ont {ref} {input.r1} "
                            f"2>/dev/null | samtools sort -o {bam} - 2>/dev/null"
                        )
                    else:
                        r2 = f" {input.r2}" if PAIRED else ""
                        map_cmd = (
                            f"bwa-mem2 mem -t {THREADS} {ref} {input.r1}{r2} "
                            f"2>/dev/null | samtools sort -o {bam} - 2>/dev/null"
                        )
                    subprocess.run(map_cmd, shell=True, check=True)
                    cov = subprocess.run(
                        ["samtools", "coverage", bam],
                        capture_output=True, text=True).stdout
                    breadth = depth = None
                    for ln in cov.splitlines():
                        if ln.startswith("#") or not ln.strip():
                            continue
                        p = ln.split("\t")
                        breadth, depth = float(p[5]), float(p[6])
                        break
                    out.write(f"{el['id']}\t{breadth}\t{depth}\t{el.get('citation', '')}\n")

    _MOBILE_INPUTS = {"mobile": rules.mobile_element_screen.output.tsv}
else:
    _MOBILE_INPUTS = {}


rule call_variants:
    """Haploid calling (V. cholerae is haploid; bcftools defaults to diploid),
    then keep only sites with QUAL >= 30 and depth >= MIN_SITE_DEPTH
    (15 for Nanopore: homopolymer noise demands stricter depth).

    Note: indel calls from Nanopore reads are unreliable; the SNV-only
    consensus rule below excludes indels by design, which is exactly right
    here. Indels are still kept in variants.vcf.gz for inspection."""
    input:
        bam=_MAP_BAM,
    output:
        raw=f"{OUTDIR}/06_variants/variants.raw.vcf.gz",
        vcf=f"{OUTDIR}/06_variants/variants.vcf.gz",
        snp_count=f"{OUTDIR}/06_variants/snp_count.txt",
    log:
        f"{OUTDIR}/06_variants/bcftools.log",
    threads: THREADS
    shell:
        """
        mkdir -p {OUTDIR}/06_variants
        bcftools mpileup -f {REF} --threads {threads} -q 20 -Q 20 \\
            {input.bam} 2> {log} | \\
            bcftools call --ploidy 1 -mv -Oz --threads {threads} \\
            -o {output.raw} 2>> {log}
        bcftools filter -i 'QUAL>=30 && INFO/DP>={MIN_SITE_DEPTH}' \\
            -Oz -o {output.vcf} {output.raw} 2>> {log}
        bcftools index -f {output.vcf} 2>> {log}
        bcftools view -H -v snps {output.vcf} | wc -l > {output.snp_count}
        """


rule depth_mask:
    """BED of positions with depth < MIN_SITE_DEPTH (incl. contigs with no
    reads at all), masked to N in the consensus so uncovered sequence is
    never reported as the reference base. Merge logic lives in
    scripts/depth_mask.awk (tested independently; see
    tests/sentinel_lite/test_depth_mask_awk.py)."""
    input:
        bam=_MAP_BAM,
    output:
        bed=f"{OUTDIR}/06_variants/low_depth_mask.bed",
    shell:
        """
        samtools depth -aa -q 20 -Q 20 {input.bam} | \\
            awk -v m={MIN_SITE_DEPTH} -f {workflow.basedir}/scripts/depth_mask.awk \\
            > {output.bed}
        """


rule consensus:
    """SNV-only consensus, so every sample stays on reference coordinates.

    Applying indels would shift sequence length per sample (observed:
    ~30 indels each, giving chr1 lengths of 3031383/3031386/3031387 across
    three samples). Cohort analyses stack these sequences positionally and
    treat column i as the same locus in every sample, which silently breaks
    the moment lengths diverge. Indels are still called and kept in
    variants.vcf.gz; they are just not applied here.
    """
    input:
        vcf=rules.call_variants.output.vcf,
        mask=rules.depth_mask.output.bed,
    output:
        fa=f"{OUTDIR}/06_variants/consensus.fasta",
        snv=f"{OUTDIR}/06_variants/variants.snv.vcf.gz",
    log:
        f"{OUTDIR}/06_variants/consensus.log",
    shell:
        """
        bcftools view -v snps -Oz -o {output.snv} {input.vcf} 2> {log}
        bcftools index -f {output.snv} 2>> {log}
        bcftools consensus -f {REF} -m {input.mask} {output.snv} \\
            > {output.fa} 2>> {log}
        """


# --------------------------------------------------------------------------
# Tier B: assembly path (Nanopore only). Defined only when tier=assembly.
# --------------------------------------------------------------------------
if TIER == "assembly":
    _FLYE_PRESET = report_lib.flye_preset_for(BASECALLER_MODEL)
    # Medaka model baked into the image at build time (see Dockerfile);
    # must match basecaller_model -- see MEDAKA_MODELS in report_lib.
    _MEDAKA_MODEL = report_lib.medaka_model_for(BASECALLER_MODEL)

    rule flye_assemble:
        """De novo assembly of Nanopore reads (Flye). Preset follows the
        basecaller: hac/sup reads are high-quality (--nano-hq)."""
        input:
            reads=rules.nanofilt_filter.output.r1,
        output:
            asm=f"{OUTDIR}/07_assembly/assembly.fasta",
        threads: THREADS
        shell:
            """
            mkdir -p {OUTDIR}/07_assembly/flye
            flye {_FLYE_PRESET} {input.reads} --genome-size 4m \\
                --threads {threads} --out-dir {OUTDIR}/07_assembly/flye \\
                2> {OUTDIR}/07_assembly/flye.log
            cp {OUTDIR}/07_assembly/flye/assembly.fasta {output.asm}
            """

    rule medaka_polish:
        """Polish with the basecaller-matched Medaka model."""
        input:
            asm=rules.flye_assemble.output.asm,
            reads=rules.nanofilt_filter.output.r1,
        output:
            polished=f"{OUTDIR}/07_assembly/polished.fasta",
        threads: THREADS
        shell:
            """
            mkdir -p {OUTDIR}/07_assembly/medaka
            medaka_consensus -i {input.reads} -d {input.asm} \\
                -o {OUTDIR}/07_assembly/medaka -m {_MEDAKA_MODEL} -t {threads} \\
                2> {OUTDIR}/07_assembly/medaka.log
            cp {OUTDIR}/07_assembly/medaka/consensus.fasta {output.polished}
            """

    rule assembly_qc:
        """Assembly stats for the QC gate (length / contigs / N50).
        The gate itself is evaluated in the report rule; a failing gate
        suppresses all lineage and AMR calls."""
        input:
            asm=rules.medaka_polish.output.polished,
        output:
            json=f"{OUTDIR}/07_assembly/assembly_qc.json",
        run:
            import json as _json

            lens = []
            with open(input.asm) as f:
                cur = 0
                for line in f:
                    if line.startswith(">"):
                        if cur:
                            lens.append(cur)
                        cur = 0
                    else:
                        cur += len(line.strip())
                if cur:
                    lens.append(cur)
            total = sum(lens)
            lens.sort(reverse=True)
            cum, n50 = 0, 0
            for L in lens:
                cum += L
                if cum >= total / 2:
                    n50 = L
                    break
            with open(output.json, "w") as f:
                _json.dump(
                    {"length_bp": total, "contigs": len(lens), "n50_bp": n50},
                    f,
                    indent=2,
                )

    rule mlst_type:
        """MLST sequence type, PubMLST V. cholerae scheme. '-' / missing -> None."""
        input:
            asm=rules.medaka_polish.output.polished,
        output:
            tsv=f"{OUTDIR}/07_assembly/mlst.tsv",
        shell:
            """
            mlst --scheme vcholerae {input.asm} > {output.tsv} 2> {OUTDIR}/07_assembly/mlst.log || true
            [ -s {output.tsv} ] || printf "%s\\t-\\t-\\n" "{input.asm}" > {output.tsv}
            """

    rule vibecheck_lineage:
        """O1 lineage placement (T1-T17) via cholgen/vibecheck.
        FIXME: confirm exact CLI flags against https://github.com/cholgen/vibecheck
        before relying on this rule; the parser (report_lib.parse_vibecheck)
        tolerates JSON {"lineage": ...} or a T<digits> token in text."""
        input:
            asm=rules.medaka_polish.output.polished,
        output:
            txt=f"{OUTDIR}/07_assembly/vibecheck.txt",
        shell:
            """
            vibecheck --input {input.asm} --output {output.txt} \\
                2> {OUTDIR}/07_assembly/vibecheck.log || \\
                echo "vibecheck: no lineage assigned" > {output.txt}
            """

    rule amr_scan:
        """AMRFinderPlus gene detection. Gene presence ONLY -- the report
        carries the gene-detected/not-detected disclaimer, never a
        susceptibility prediction (RUO posture)."""
        input:
            asm=rules.medaka_polish.output.polished,
        output:
            tsv=f"{OUTDIR}/07_assembly/amrfinder.tsv",
            version=f"{OUTDIR}/07_assembly/amrfinder_version.txt",
        threads: THREADS
        shell:
            """
            amrfinder -n {input.asm} --organism "Vibrio cholerae" \\
                --threads {threads} -o {output.tsv} \\
                2> {OUTDIR}/07_assembly/amrfinder.log || \\
                printf "Gene symbol\\n" > {output.tsv}
            amrfinder --version > {output.version} 2>&1 || \\
                echo "unknown" > {output.version}
            """


rule tool_versions:
    """Best-effort tool+DB versions for the per-sample manifest. A tool that
    is absent or errors records 'unknown' -- version collection never fails
    a run. Medaka model comes from config (baked into the image); the
    AMRFinderPlus DB version is parsed from `amrfinder --version` output."""
    output:
        json=f"{OUTDIR}/tool_versions.json",
    run:
        import json as _json

        specs = [
            ("kraken2", ["kraken2", "--version"]),
            ("samtools", ["samtools", "--version"]),
            ("bcftools", ["bcftools", "--version"]),
        ]
        if PLATFORM == "illumina":
            specs += [("fastp", ["fastp", "--version"]), ("bwa-mem2", ["bwa-mem2", "version"])]
        else:
            specs += [
                ("nanoplot", ["NanoPlot", "--version"]),
                ("chopper", ["chopper", "--version"]),
                ("minimap2", ["minimap2", "--version"]),
            ]
        if TIER == "assembly":
            specs += [
                ("flye", ["flye", "--version"]),
                ("medaka", ["medaka", "--version"]),
                ("mlst", ["mlst", "--version"]),
                ("amrfinder", ["amrfinder", "--version"]),
            ]
        versions = report_lib.collect_tool_versions(specs)
        versions["kraken_db"] = "kraken2_haiti_custom"
        if PLATFORM == "nanopore":
            versions["medaka_model"] = report_lib.medaka_model_for(BASECALLER_MODEL)
        with open(output.json, "w") as f:
            _json.dump(versions, f, indent=2)


def _run_report(input, output):
    """Shared rep body; assembly inputs are only present when
    tier=assembly (the rule variants below select at parse time)."""
    import json as _json, os

    def load_json(p):
        with open(p) as f:
            return _json.load(f)

    fp = load_json(input.summary)
    before = fp["summary"]["before_filtering"]["total_reads"]
    after = fp["summary"]["after_filtering"]["total_reads"]

    cholerae_reads, _unclass, _root, total_kraken = \
        report_lib.parse_kraken_report(input.kraken_report)
    v_cholerae_fraction, species_purity_pct = \
        report_lib.species_purity(cholerae_reads, total_kraken)

    ex = load_json(input.extract_stats)

    mean_depth, breadth = report_lib.genome_wide_coverage(input.coverage)
    with open(input.flagstat) as _f:
        mapped = report_lib.parse_flagstat_mapped(_f.read())

    bed_labels = report_lib.parse_loci_bed(input.loci_bed)
    loci_calls = report_lib.call_loci(
        input.loci, bed_labels, LOCUS_PRESENT_BREADTH, LOCUS_ABSENT_BREADTH)

    snps = report_lib.read_snp_count(input.snp_count)
    cons_len, cons_n, called_pct = report_lib.consensus_stats(input.consensus)

    # QC gate: a failing run still gets a rep (for inspection), but its
    # variants/consensus/loci calls must not be treated as results.
    qc_status, qc_reasons = report_lib.evaluate_qc(
        mean_depth, called_pct, species_purity_pct,
        {
            "min_mean_depth": QC_MIN_MEAN_DEPTH,
            "min_called_pct": QC_MIN_CALLED_PCT,
            "min_species_purity": QC_MIN_SPECIES_PURITY,
            "hard_min_called_pct": QC_HARD_MIN_CALLED_PCT,
            "hard_min_species_purity": QC_HARD_MIN_SPECIES_PURITY,
        },
    )

    # Phase 5B: allele calls, ICE profile, mobile-element screens. All are
    # QC-gated like the other calls: a failed sample reports
    # not_interpretable, never results.
    if qc_status == "fail":
        alleles_block = {"status": "not_interpretable",
                         "reason": "qc.status is 'fail'"}
        ice_block = {"pattern": "indeterminate", "segments": {},
                     "note": "qc.status is 'fail'; ICE calls not interpretable"}
        mobile_block = {"status": "not_interpretable",
                        "reason": "qc.status is 'fail'"}
    else:
        allele_table = report_lib.load_alleles(ALLELES_YAML)
        alleles_block = report_lib.call_alleles(
            input.vcf, input.consensus, allele_table)
        ice_labels = report_lib.parse_loci_bed(input.ice_bed)
        ice_calls = report_lib.call_loci(
            input.ice, ice_labels, LOCUS_PRESENT_BREADTH, LOCUS_ABSENT_BREADTH)
        ice_block = report_lib.profile_ice_segments(
            {name: v["breadth_pct"] for name, v in ice_calls.items()})
        if hasattr(input, "mobile"):
            rows = []
            with open(input.mobile) as _mf:
                _mf.readline()  # header
                for ln in _mf:
                    p = ln.rstrip("\n").split("\t")
                    if len(p) >= 4:
                        rows.append({
                            "element": p[0],
                            "breadth_pct": float(p[1]) if p[1] != "None" else None,
                            "mean_depth": float(p[2]) if p[2] != "None" else None,
                            "citation": p[3],
                        })
            mobile_block = {
                "status": "screened",
                "elements": report_lib.summarize_mobile_elements(rows),
            }
        else:
            mobile_block = {
                "status": "not_screened",
                "reason": "mobile_elements.yaml lists no elements with "
                          "verified reference sequences",
            }

    rep = {
        "pipeline": "vibrion-sentinel-lite",
        "version": report_lib.PIPELINE_VERSION,
        "accession": ACC,
        # Sample metadata from the ENA filereport (may be null when ENA
        # lacks it or the SRA Toolkit fallback ran). The recurrence/cluster
        # watcher needs collection_date; undated rows are excluded from
        # temporal logic, never given an invented date.
        "collection_date": config.get("collection_date"),
        "country": config.get("country"),
        "platform": PLATFORM,
        "basecaller_model": BASECALLER_MODEL,
        "tier": TIER,
        "reference": "2010EL-1786 (7PET, CP003069.1/CP003070.1)",
        "reads": {
            "raw": before,
            "qc_passed": after,
            "vibrio_kept": ex["kept_for_mapping"],
        },
        "classification": {
            "kraken_db": "kraken2_haiti_custom",
            "v_cholerae_reads": cholerae_reads,
            "v_cholerae_fraction": round(v_cholerae_fraction, 4),
        },
        "mapping": {
            "mapped_reads": mapped,
            "mean_depth": round(mean_depth, 2),
            "breadth_pct": round(breadth, 2),
        },
        "variants": {"snps_vs_7pet": snps},
        "surveillance_loci": loci_calls,
        # Phase 5B: curated allele observations (RUO), ICE structural
        # pattern, mobile-element screens. None of these gate the R1/R2
        # watch rules in scripts/watch_rules.py.
        "alleles": alleles_block,
        "ice_profile": ice_block,
        "mobile_elements": mobile_block,
        "consensus_length": cons_len,
        "consensus_called_pct": round(called_pct, 2),
        "tool_versions": load_json(input.versions),
        "qc": {
            "status": qc_status,
            "reasons": qc_reasons,
            "thresholds": {
                "locus_present_breadth": LOCUS_PRESENT_BREADTH,
                "locus_absent_breadth": LOCUS_ABSENT_BREADTH,
                "min_site_depth": MIN_SITE_DEPTH,
                "min_mean_depth": QC_MIN_MEAN_DEPTH,
                "min_called_pct": QC_MIN_CALLED_PCT,
                "min_species_purity": QC_MIN_SPECIES_PURITY,
                "hard_min_called_pct": QC_HARD_MIN_CALLED_PCT,
                "hard_min_species_purity": QC_HARD_MIN_SPECIES_PURITY,
            },
        },
        "notes": "Lite tier: mapping-based, no de novo assembly. "
                 "Consensus positions below min_site_depth are N. "
                 "If qc.status is 'fail', variants, consensus and loci "
                 "calls are not interpretable. Loci BED is provisional "
                 "and does not yet support serogroup/biotype calls. "
                 "Allele calls (ctxB/tcpA/rtxA/hapR/vexB) are sequence-level "
                 "observations with citations (RUO), never predictions of "
                 "virulence, transmissibility, or clinical outcome. "
                 "The YemVchMDRI screen runs on the assembly tier only.",
    }

    if TIER == "assembly":
        asm_stats = report_lib.parse_assembly_qc(input.assembly_qc)
        gate_status, gate_reasons = report_lib.assembly_qc_gate(asm_stats)
        rep["assembly"] = report_lib.build_assembly_block(
            asm_stats,
            report_lib.parse_mlst(input.mlst),
            report_lib.parse_vibecheck(input.vibecheck),
            report_lib.parse_amrfinder(input.amr),
            gate_status,
        )
        # Phase 5B.7: YemVchMDRI gene-set screen on the AMRFinderPlus genes.
        # Assembly tier only -- the lite tier does not run AMRFinderPlus.
        rep["yemvchmdri"] = report_lib.plasmid_screen(
            report_lib.parse_amrfinder(input.amr))
        with open(input.amr_version) as _f:
            rep["assembly"]["amrfinder_db_version"] = \
                report_lib.amrfinder_db_version(_f.read())
        if gate_status == "fail":
            # A fragmented assembly invalidates the whole sample: lineage
            # and AMR calls are already suppressed in the assembly block.
            qc_status = "fail"
            qc_reasons = qc_reasons + [
                f"assembly_qc: {r}" for r in gate_reasons
            ]
            rep["qc"]["status"] = qc_status
            rep["qc"]["reasons"] = qc_reasons
        rep["notes"] += (
            " Assembly tier: Flye + Medaka (basecaller-matched model); "
            "MLST/vibecheck/AMRFinderPlus calls require a passing assembly "
            "QC gate. AMR output is gene detected/not detected only -- "
            "not a susceptibility prediction."
        )

    os.makedirs(OUTDIR, exist_ok=True)
    with open(output.json, "w") as f:
        _json.dump(rep, f, indent=2)
    print(_json.dumps(rep, indent=2)[:2000])


# Report rule variants: assembly inputs exist only when tier=assembly.
# (Snakemake 9 no longer accepts unpack() on a plain dict here, so the
#  variants are selected at parse time instead.)
if TIER == "assembly":
    rule report:
        input:
            summary=_QC_SUMMARY,
            kraken_report=rules.kraken2_classify.output.report,
            extract_stats=rules.extract_vibrio.output.stats,
            coverage=rules.coverage_stats.output.cov,
            flagstat=rules.coverage_stats.output.flag,
            loci=rules.loci_coverage.output.txt,
            loci_bed=LOCI_BED,
            snp_count=rules.call_variants.output.snp_count,
            vcf=rules.call_variants.output.vcf,
            consensus=rules.consensus.output.fa,
            ice=rules.ice_segments.output.txt,
            ice_bed=ICE_BED,
            versions=rules.tool_versions.output.json,
            assembly_qc=rules.assembly_qc.output.json,
            mlst=rules.mlst_type.output.tsv,
            vibecheck=rules.vibecheck_lineage.output.txt,
            amr=rules.amr_scan.output.tsv,
            amr_version=rules.amr_scan.output.version,
            **_MOBILE_INPUTS,
        output:
            json=f"{OUTDIR}/report.json",
        run:
            _run_report(input, output)
else:
    rule report:
        input:
            summary=_QC_SUMMARY,
            kraken_report=rules.kraken2_classify.output.report,
            extract_stats=rules.extract_vibrio.output.stats,
            coverage=rules.coverage_stats.output.cov,
            flagstat=rules.coverage_stats.output.flag,
            loci=rules.loci_coverage.output.txt,
            loci_bed=LOCI_BED,
            snp_count=rules.call_variants.output.snp_count,
            vcf=rules.call_variants.output.vcf,
            consensus=rules.consensus.output.fa,
            ice=rules.ice_segments.output.txt,
            ice_bed=ICE_BED,
            versions=rules.tool_versions.output.json,
            **_MOBILE_INPUTS,
        output:
            json=f"{OUTDIR}/report.json",
        run:
            _run_report(input, output)
