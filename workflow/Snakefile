# Rule 9: Generate comprehensive surveillance report
rule generate_comprehensive_report:
    input:
        evo2_result=rules.evo2_analyze.output.report,
        snp_report=rules.call_variants.output.snp_report,
        structural_report=rules.validate_structural_variants.output.report,
        amr_report=rules.detect_amr.output.amr_report,
        vibrio_stats=rules.extract_vibrio.output.stats,
        serogroup_report=rules.detect_serogroup.output.report,
        phenotype_report=rules.predict_phenotype.output.report,
        phage_report=rules.phage_sentinel.output.report,
        rgi_report=rules.detect_amr_rgi.output.report, # Deep AMR (Drug Card)
        vcf=rules.call_variants.output.vcf,
        triage=rules.strain_triage.output.decision,
        coverage_integrity=rules.verify_coverage_integrity.output.report,
        phylo_tree="{output_dir}/{{sample}}/10_phylogeny/tree.nwk".format(output_dir=config["output_dir"]),
        phylo_png="{output_dir}/{{sample}}/10_phylogeny/tree.png".format(output_dir=config["output_dir"]),
        qc_checksum=rules.validate_checksum.output.report,
        ctx_report=rules.detect_ctx_integration.output.report,
        sxt_report=rules.assemble_sxt.output.report,
        platform_report=rules.detect_platform.output.report,
        global_match=rules.global_triage.output.global_match_json,
        broad_report=rules.kraken2_broad_audit.output.kraken_report,
        polished=rules.polish_consensus.output.polished
    output:
        report="{output_dir}/{{sample}}/08_comprehensive_report/surveillance_report.md".format(
            output_dir=config["output_dir"]
        ),
        json="{output_dir}/{{sample}}/08_comprehensive_report/surveillance_report.json".format(
            output_dir=config["output_dir"]
        )
    params:
        sample_id=lambda wildcards: wildcards.sample,
        outdir=lambda wildcards, output: os.path.dirname(output.report)
    conda:
        "envs/analysis.yaml"
    log:
        "{output_dir}/{{sample}}/logs/comprehensive_report.log".format(output_dir=config["output_dir"])
    script:
        "scripts/generate_comprehensive_report.py"
