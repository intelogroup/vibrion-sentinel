# --- Phase 3: Visual Phylogenetics (Permissive Stack) ---

# Rule 13: Permissive Phylogeny (Biopython + MAFFT)
# Replaces Augur/IQ-TREE with MIT/BSD compliant stack.
# Professional CholeraSeq Architecture.
# Replaces de-novo alignment with reference-based core matrix.
# Engine: IQ-TREE2 (+ASC) + TreeTime.
rule cholera_seq_tree:
    input:
        consensus=rules.polish_consensus.output.polished,
        loci=rules.extract_surveillance_loci.output.loci_fasta,
        ref_alignment="data/core_alignment/reference_core_alignment.fasta"
    output:
        tree_nwk="{output_dir}/{{sample}}/10_phylogeny/tree.nwk".format(
            output_dir=config["output_dir"]
        ),
        tree_png="{output_dir}/{{sample}}/10_phylogeny/tree.png".format(
            output_dir=config["output_dir"]
        )
    params:
        outdir=lambda wildcards, output: os.path.dirname(output.tree_nwk),
        sample_id=lambda wildcards: wildcards.sample
    conda:
        "envs/analysis.yaml"
    threads: config["threads"]
    shell:
        """
        python3 workflow/scripts/cholera_seq_tree.py \
            --consensus {input.consensus} \
            --loci {input.loci} \
            --sample-id {params.sample_id} \
            --outdir {params.outdir} \
            --threads {threads}
        """

# Rule 13b: Enhanced Tree Visualization (ggtree)
