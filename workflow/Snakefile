# Rule 3d: Fast EVO2-API Rescue (Replaces slow local embedding)
# Rule 3d: Kaiju Rescue (Tier 2: Mutation-Tolerant Classification)
# Replaces expensive Evo2 API with free, local protein-level k-mer matching
# Rule 3d: MMseqs2 Deep Rescue (Tier 2: Mutation-Tolerant Classification)
# Replaces Kaiju/Evo2 with ARM-optimized approximate alignment (easy-taxonomy)
rule rescue_vibrio_reads:
    input:
        unclassified=rules.extract_unclassified.output.unclassified
    output:
        rescued="{output_dir}/{{sample}}/03_rescue/{{sample}}_rescued_vibrio.fastq.gz".format(
            output_dir=config["output_dir"]
        ),
        stats="{output_dir}/{{sample}}/03_rescue/rescue_stats.json".format(
            output_dir=config["output_dir"]
        )
    params:
        db=config["mmseqs_db"],
        min_seq_id=config["mmseqs_min_seq_id"],
        threads=config.get("mmseqs_threads", 4)
    conda:
        "envs/analysis.yaml"
    threads: config.get("mmseqs_threads", 4)
    log:
        "{output_dir}/{{sample}}/logs/rescue_reads.log".format(output_dir=config["output_dir"])
    script:
        "scripts/mmseqs_rescue.py"

# Rule 3e: Merge classified + rescued Vibrio reads
rule merge_vibrio_reads:
    input:
        classified=rules.extract_vibrio.output.vibrio_fastq,
        rescued=rules.rescue_vibrio_reads.output.rescued
    output:
        merged="{output_dir}/{{sample}}/03_vibrio/{{sample}}_vibrio_complete.fastq.gz".format(
            output_dir=config["output_dir"]
        )
    log:
        "{output_dir}/{{sample}}/logs/merge_vibrio.log".format(output_dir=config["output_dir"])
    script:
        "scripts/merge_vibrio_reads.py"

# Rule 4a: Index Reference for BWA
rule bwa_index:
    input:
        reference=select_reference
    output:
        idx=directory("data/references/bwa_index_{sample}") # Use wildcards to make it unique per sample/ref logic? No, ref is dynamic.
        # Actually, select_reference depends on wildcards.sample.
        # Ideally we index the reference ONCE. But select_reference is dynamic.
        # Let's verify: select_reference returns a path string based on wildcards.
        # If the path is constant (usually), fine. But if it changes (O139 vs O1), we need to trigger index for THAT reference.
        # Minimap2 didn't need a separate index step (it does it on the fly or accepts fasta).
        # BWA needs index files (.amb, .ann, .bwt, .pac, .sa) alongside the fasta.
        # Since I can't predict the filename easily in output without dynamic logic,
        # I will run 'bwa index' INSIDE the alignment rule if the index is missing, or create a rule that outputs the specific index files.
        # A simpler approach for this pipeline (since typically 1 reference is used per batch) is to check/build index in align_to_reference shell.
        # BUT standard snakemake practice prefers a rule.
        # Given "select_reference" is a function, it's safer to build the index inside the alignment rule script to handle valid dynamic paths.
        # OR: I can add 'bwa index' to the shell command of align_to_reference.
        # Let's do that for Robustness.

# Rule 3f: Sketch sample for global triage
rule sketch_sample_triage:
    input:
        fastq=rules.merge_vibrio_reads.output.merged
    output:
        sig="{output_dir}/{{sample}}/07_triage/sample.sig".format(
            output_dir=config["output_dir"]
        )
    conda:
        "envs/analysis.yaml"
    shell:
        """
        sourmash sketch dna {input.fastq} -o {output.sig} --name {wildcards.sample}
        """

# Rule 3g: Regional Reference Triage (Best Baseline Selection)
checkpoint global_reference_triage:
    input:
        sig=rules.sketch_sample_triage.output.sig
    output:
        match="{output_dir}/{{sample}}/07_triage/regional_selection.json".format(
            output_dir=config["output_dir"]
        )
    params:
        ref_dir="data/references"
    shell:
        """
        python3 scripts/triage_reference.py --sample-sig {input.sig} --ref-dir {params.ref_dir} --output {output.match}
        """

# Rule 4: Align Vibrio reads to reference genome
checkpoint align_to_reference:
    input:
        vibrio_fastq=rules.merge_vibrio_reads.output.merged,
        reference=select_reference,
        triage_match=rules.global_reference_triage.output.match # Ensure triage runs first
    output:
        bam=config["output_dir"] + "/{sample}/04_alignment/{sample}_aligned.sorted.bam",
        bai=config["output_dir"] + "/{sample}/04_alignment/{sample}_aligned.sorted.bam.bai",
        rescue_stats=config["output_dir"] + "/{sample}/04_alignment/{sample}_unmapped_rescue_stats.json",
        rescue_log=config["output_dir"] + "/{sample}/04_alignment/{sample}_unmapped_rescue.log",
        manifest=config["output_dir"] + "/{sample}/04_alignment/alignment_manifest.json"
    params:
        outdir=lambda wildcards, output: os.path.dirname(output.bam),
        mapping_rescue_enabled=config.get("mapping_rescue_enabled", False),
        mapping_rescue_confidence_threshold=config.get("mapping_rescue_confidence_threshold", 0.6),
        mapping_rescue_max_reads=config.get("mapping_rescue_max_reads", 5000),
        aligner_type=config.get("aligner_type", "bwa")
    threads: config["threads"]
    conda:
        "envs/analysis.yaml"
    log:
        config["output_dir"] + "/{sample}/logs/align.log"
    shell:
        """
        mkdir -p {params.outdir}

        set -euo pipefail

        tmp_bam="{params.outdir}/{wildcards.sample}._tmp.initial.bam"
        tmp_mapped_bam="{params.outdir}/{wildcards.sample}._tmp.mapped_only.bam"
        tmp_unmapped_fastq="{params.outdir}/{wildcards.sample}._tmp.unmapped.fastq.gz"
        tmp_rescued_fastq="{params.outdir}/{wildcards.sample}._tmp.unmapped_rescued.fastq.gz"
        tmp_rescue_stats="{params.outdir}/{wildcards.sample}._tmp.unmapped_rescue_stats.json"
        tmp_rescue_log="{params.outdir}/{wildcards.sample}._tmp.unmapped_rescue.log"
        tmp_rescued_bam="{params.outdir}/{wildcards.sample}._tmp.rescued.bam"
        final_rescue_stats="{output.rescue_stats}"
        final_rescue_log="{output.rescue_log}"
        
        # Forensic Alignment: Hybrid Strategy (Routing by Data Type)
        # Type A: Illumina (BWA-MEM) - Optimised for SNPs and small indels
        # Type B: Long Read/SV (Minimap2) - Optimised for structural variants
        
        ALIGNER="{params.aligner_type}"
        
        if [ "$ALIGNER" == "bwa" ]; then
            # 1. Check/Build BWA Index (if missing)
            if [ ! -f "{input.reference}.bwt" ]; then
                echo "[bwa] indexing reference {input.reference}" >> {log}
                bwa index {input.reference} 2>> {log}
            fi

            # 2. Align with BWA-MEM (Standard Forensic Mode)
            # -B 3: Relaxed mismatch penalty (Catch Inaba mutations)
            # -M: Mark split hits as secondary (Picard/Pilon compatibility)
            echo "[align] Running BWA-MEM optimization..." >> {log}
            bwa mem -t {threads} -B 3 -M {input.reference} {input.vibrio_fastq} 2>> {log} | \
                samtools view -b - | \
                samtools sort -@ {threads} -o "$tmp_bam" - 2>> {log}
                
        elif [ "$ALIGNER" == "minimap2" ]; then
            # Long-Read / Structural Mode
            echo "[align] Running Minimap2 optimization..." >> {log}
            minimap2 -ax map-ont -t {threads} {input.reference} {input.vibrio_fastq} 2>> {log} | \
                samtools view -b - | \
                samtools sort -@ {threads} -o "$tmp_bam" - 2>> {log}
        else
            echo "[error] Unknown aligner type: $ALIGNER" >> {log}
            exit 1
        fi

        if [ "{params.mapping_rescue_enabled}" = "True" ]; then
            echo "[mapping_rescue] enabled: extracting unmapped reads" >> {log}

            # Keep only mapped alignments from the first pass
            samtools view -b -F 4 "$tmp_bam" > "$tmp_mapped_bam" 2>> {log}

            # Extract unmapped reads as FASTQ
            samtools fastq -f 4 "$tmp_bam" 2>> {log} | gzip -c > "$tmp_unmapped_fastq"

            if gzip -cd "$tmp_unmapped_fastq" | head -n 1 | grep -q .; then
                echo "[mapping_rescue] running Evo2 rescue on unmapped reads" >> {log}

                python scripts/evo2_rescue.py \
                    --input "$tmp_unmapped_fastq" \
                    --output "$tmp_rescued_fastq" \
                    --stats "$tmp_rescue_stats" \
                    --threshold {params.mapping_rescue_confidence_threshold} \
                    --max-reads {params.mapping_rescue_max_reads} \
                    --log "$tmp_rescue_log" \
                    2>> {log}

                if gzip -cd "$tmp_rescued_fastq" | head -n 1 | grep -q .; then
                    echo "[mapping_rescue] remapping rescued reads" >> {log}

                    # Remap using the SAME aligner as primary
                    if [ "$ALIGNER" == "bwa" ]; then
                        bwa mem -t {threads} -B 3 -M {input.reference} "$tmp_rescued_fastq" 2>> {log} | \
                            samtools view -b - > "$tmp_rescued_bam" 2>> {log}
                    else
                         minimap2 -ax map-ont -t {threads} {input.reference} "$tmp_rescued_fastq" 2>> {log} | \
                            samtools view -b - > "$tmp_rescued_bam" 2>> {log}
                    fi

                    # Merge mapped-first-pass + rescued-remap, then sort to final BAM
                    samtools merge -f -@ {threads} - "$tmp_mapped_bam" "$tmp_rescued_bam" 2>> {log} | \
                        samtools sort -@ {threads} -o {output.bam} - 2>> {log}
                else
                    echo "[mapping_rescue] no reads rescued by Evo2; using first-pass mapped reads" >> {log}
                    samtools sort -@ {threads} -o {output.bam} "$tmp_mapped_bam" 2>> {log}
                fi
            else
                echo "[mapping_rescue] no unmapped reads extracted; using first-pass BAM" >> {log}
                mv "$tmp_bam" {output.bam}
            fi
        else
            mv "$tmp_bam" {output.bam}
        fi
        
        # Index BAM file
        samtools index {output.bam} 2>> {log}

        if [ -f "$tmp_rescue_stats" ]; then
            mv "$tmp_rescue_stats" "$final_rescue_stats"
        else
            echo '{{}}' > "$final_rescue_stats"
        fi

        if [ -f "$tmp_rescue_log" ]; then
            mv "$tmp_rescue_log" "$final_rescue_log"
        else
            echo "mapping_rescue: not run" > "$final_rescue_log"
        fi

        # TODO: Re-enable manifest generation after fixing formatting issue
        echo '{{"step": "alignment", "status": "completed"}}' > {output.manifest}

        # Best-effort cleanup
        rm -f "$tmp_mapped_bam" "$tmp_rescued_bam" "$tmp_unmapped_fastq" "$tmp_rescued_fastq" \
              "$tmp_bam" 2>/dev/null || true
        """

