# Rule 9: Evo2 Sentinel Analysis (Tier 3 - Conditional Cloud Escalation)
# Only runs if local triage (Tier 0-2) flags sample for cloud analysis
rule evo2_analyze:
    input:
        loci_fasta=rules.extract_surveillance_loci.output.loci_fasta,
        sentinel_loci=config["evo2"]["sentinel_loci"].format(output_dir=config["output_dir"]),
        outbreak_loci=config["evo2"]["outbreak_loci"],
        triage_json=rules.local_triage.output.triage_json
    output:
        report="{output_dir}/{{sample}}/07_evo2/evo2_analysis.json".format(
            output_dir=config["output_dir"]
        )
    params:
        sample_id=lambda wildcards: wildcards.sample,
        evo2_url=config.get("evo_api_url"),
        api_key=os.environ.get("NVIDIA_API_KEY", "")
    conda:
        "envs/analysis.yaml"
    log:
        "{output_dir}/{{sample}}/logs/evo2_analyze.log".format(output_dir=config["output_dir"])
    run:
        import json
        
        # Check if local triage escalated to cloud
        with open(input.triage_json) as f:
            triage = json.load(f)
        
        escalate = triage.get("final_decision", {}).get("escalate_to_cloud", False)
        
        if escalate:
            # Run Evo2 cloud analysis
            shell("""
                python3 workflow/scripts/run_evo2.py \
                    --sample-fasta {input.loci_fasta} \
                    --sentinel-fasta {input.sentinel_loci} \
                    --outbreak-fasta {input.outbreak_loci} \
                    --api-url {params.evo2_url} \
                    --api-key {params.api_key} \
                    --output {output.report} \
                    2>&1 | tee {log}
            """)
        else:
            # Skip cloud analysis - create placeholder report
            result = {
                "tier": 3,
                "method": "Evo2 Cloud",
                "skipped": True,
                "reason": "Local triage verified sample as low risk",
                "triage_summary": triage.get("final_decision", {}).get("cascade_summary", {})
            }
            
            with open(output.report, 'w') as f:
                json.dump(result, f, indent=2)
            
            with open(log[0], 'w') as f:
                f.write("Evo2 analysis skipped - local triage verified sample\n")

# Rule 10: HyenaDNA Structural Surveillance (Tier 3 - Long Context)
# "The Eye of the Storm" - 1M bp context for Island Detection
rule hyena_analyze:
    input:
        assembly="results/assembly/{sample}_polished.fasta"
    output:
        report="{output_dir}/{{sample}}/07_hyena/hyena_analysis.json".format(output_dir=config["output_dir"])
    params:
        model_dir="data/models/hyena",
        script="workflow/scripts/run_hyena.py"
    log:
        "{output_dir}/{{sample}}/logs/hyena_analyze.log".format(output_dir=config["output_dir"])
    threads: 4 # MPS handles parallelism, but we limit CPU threads
    shell:
        """
        mkdir -p $(dirname {output.report})
        python3 {params.script} \
            --input {input.assembly} \
            --model-dir {params.model_dir} \
            --output {output.report} \
            > {log} 2>&1
        """

