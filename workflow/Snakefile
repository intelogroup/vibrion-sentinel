    input:
        vibrio_fastq=rules.merge_vibrio_reads.output.merged,
        reference=select_reference
    output:
        bam="{output_dir}/{{sample}}/04_alignment/{{sample}}_structural.sorted.bam".format(
            output_dir=config["output_dir"]
        ),
        bai="{output_dir}/{{sample}}/04_alignment/{{sample}}_structural.sorted.bam.bai".format(
            output_dir=config["output_dir"]
        )
    params:
        outdir=lambda wildcards, output: os.path.dirname(output.bam),
        aligner_type=config.get("aligner_type", "bwa") # Does the primary match?
    threads: config["threads"]
    conda:
        "envs/analysis.yaml"
    log:
        "{output_dir}/{{sample}}/logs/align_structural.log".format(output_dir=config["output_dir"])
    shell:
        """
        # If primary is already Minimap2, just symlink it to save time
        if [ "{params.aligner_type}" == "minimap2" ]; then
             echo "[sv_align] Primary is already Minimap2. Symlinking..." >> {log}
             # Wait for primary to finish (handled by Snakemake if we link inputs, but here we just link outputs)
             # ACTUALLY, simpler to just run it or copy. Symlinking output of another rule is tricky in Snakemake
             # without explicit dependency. 
             # Let's just run Minimap2. It's fast.
             minimap2 -ax sr -t {threads} {input.reference} {input.vibrio_fastq} 2>> {log} | \
                samtools view -b - | \
                samtools sort -@ {threads} -o {output.bam} - 2>> {log}
        else
             echo "[sv_align] Running Supplementary Minimap2 Alignment (Short Read Mode)..." >> {log}
             minimap2 -ax sr -t {threads} {input.reference} {input.vibrio_fastq} 2>> {log} | \
                samtools view -b - | \
                samtools sort -@ {threads} -o {output.bam} - 2>> {log}
        fi
        
        samtools index {output.bam} 2>> {log}
        """

