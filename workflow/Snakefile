    output:
        triage_json="{output_dir}/{{sample}}/07_triage/local_triage.json".format(
            output_dir=config["output_dir"]
        )
    params:
        hyena_model=config.get("triage", {}).get("hyena_model", "LongSafari/hyenadna-tiny-1k-seqlen-hf"),
        hyena_threshold=config.get("triage", {}).get("hyena_threshold", 15.0),
        hyena_window=config.get("triage", {}).get("hyena_window_size", 500),
        hyenadna_tier2_model=config.get("triage", {}).get("hyenadna_tier2_model", "LongSafari/hyenadna-tiny-1k-seqlen-hf"),
        hyenadna_tier2_loci=config.get("triage", {}).get("hyenadna_tier2_loci", ["ctxB", "wbeT", "tcpA", "gyrA", "parE", "scrABC", "katB", "ahpC", "hapR"]),
        hyenadna_tier2_threshold=config.get("triage", {}).get("hyenadna_tier2_threshold", 2.0),
        hyenadna_tier2_overlap=config.get("triage", {}).get("hyenadna_tier2_overlap_threshold", 0.5),
        device=config.get("triage", {}).get("device", "mps"),
        model_cache=config.get("triage", {}).get("model_cache_dir", "data/models/triage")
    conda:
        "envs/analysis.yaml"
    log:
        "{output_dir}/{{sample}}/logs/local_triage.log".format(output_dir=config["output_dir"])
    shell:
        """
        export PYTORCH_ENABLE_MPS_FALLBACK=1
        $CONDA_PREFIX/bin/python3 workflow/scripts/local_triage.py \
            --tier0-json {input.tier0_json} \
            --sample {input.sample_fasta} \
            --ref-fasta {input.ref_fasta} \
            --loci-fasta {input.loci_fasta} \
            --hyena-model {params.hyena_model} \
            --hyena-threshold {params.hyena_threshold} \
            --hyena-window-size {params.hyena_window} \
            --caduceus-model {params.hyenadna_tier2_model} \
            --caduceus-loci {params.hyenadna_tier2_loci} \
            --caduceus-threshold {params.hyenadna_tier2_threshold} \
            --caduceus-overlap-threshold {params.hyenadna_tier2_overlap} \
