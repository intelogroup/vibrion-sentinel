# Rule 7: Generate consensus genome from BAM
rule generate_consensus:
    input:
        bam=rules.align_to_reference.output.bam,
        reference=select_reference
    output:
        fasta="{output_dir}/{{sample}}/09_consensus/{{sample}}_consensus.fasta".format(
            output_dir=config["output_dir"]
        ),
        summary="{output_dir}/{{sample}}/09_consensus/consensus_generation_summary.json".format(
            output_dir=config["output_dir"]
        ),
        manifest="{output_dir}/{{sample}}/09_consensus/consensus_manifest.json".format(
            output_dir=config["output_dir"]
        )
    params:
        outdir=lambda wildcards, output: os.path.dirname(output.fasta),
        sample_id=lambda wildcards: wildcards.sample
    conda:
        "envs/analysis.yaml"
    log:
        "{output_dir}/{{sample}}/logs/generate_consensus.log".format(output_dir=config["output_dir"])
    shell:
        """
        mkdir -p {params.outdir}
        python3 workflow/scripts/generate_consensus_genome.py \
            --bam {input.bam} \
            --ref {input.reference} \
            --outdir {params.outdir} \
            --sample {params.sample_id} \
            2>&1 | tee {log}

        python3 - <<'PY'
import json
import hashlib
import time
import platform

def sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b''):
            h.update(chunk)
    return h.hexdigest()

# Load summary metrics
with open("{output.summary}") as f:
    summary = json.load(f)

manifest = {{
    "step": "consensus",
    "timestamp": time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
    "inputs": {{
        "bam": "{input.bam}",
        "reference": "{input.reference}"
    }},
    "outputs": {{
        "consensus_fasta": "{output.fasta}",
        "summary": "{output.summary}"
    }},
    "hashes": {{
        "bam_sha256": sha256("{input.bam}"),
        "reference_sha256": sha256("{input.reference}"),
        "consensus_sha256": sha256("{output.fasta}"),
        "summary_sha256": sha256("{output.summary}")
    }},
    "qc_metrics": {{
        "reference_length": summary.get("statistics", {{}}).get("reference_length"),
        "coverage_percentage": summary.get("statistics", {{}}).get("coverage_percentage"),
        "mean_depth": summary.get("statistics", {{}}).get("mean_depth"),
        "median_depth": summary.get("statistics", {{}}).get("median_depth"),
        "max_depth": summary.get("statistics", {{}}).get("max_depth"),
        "heterogeneous_sites": summary.get("statistics", {{}}).get("heterogeneous_sites_count"),
        "confident_positions": summary.get("statistics", {{}}).get("confident_positions")
    }},
    "tools": {{
        "python": platform.python_version()
    }},
    "log": "{log}"
}}

with open("{output.manifest}", "w") as f:
    json.dump(manifest, f, indent=2)
PY
        """

