# Rule 0: Quality Control with fastp (CholeraSeq Standard: Q20, 4bp window)
rule fastp_qc:
    input:
        fastq=lambda wildcards: "{samples_dir}/{sample}_1.fastq.gz".format(samples_dir=config["samples_dir"], sample=wildcards.sample) if os.path.exists("{samples_dir}/{sample}_1.fastq.gz".format(samples_dir=config["samples_dir"], sample=wildcards.sample)) else "{samples_dir}/{sample}.fastq.gz".format(samples_dir=config["samples_dir"], sample=wildcards.sample)
    output:
        cleaned="{output_dir}/{{sample}}/00_fastp/{{sample}}_1.fastq.gz".format(
            output_dir=config["output_dir"]
        ),
        json="{output_dir}/{{sample}}/00_fastp/fastp.json".format(
            output_dir=config["output_dir"]
        ),
        html="{output_dir}/{{sample}}/00_fastp/fastp.html".format(
            output_dir=config["output_dir"]
        )
    params:
        outdir=lambda wildcards, output: os.path.dirname(output.cleaned),
        memory_tier=get_memory_tier
    threads: get_adaptive_threads
    conda:
        "envs/analysis.yaml"
    log:
        "{output_dir}/{{sample}}/logs/fastp.log".format(output_dir=config["output_dir"])
    shell:
        """
        mkdir -p {params.outdir}
        
        R1="{input.fastq}"
        R2=""
        # Detect R2 (robust check)
        if [[ "$R1" == *"_1.fastq.gz" ]]; then
            R2_CHECK="${{R1/_1.fastq.gz/_2.fastq.gz}}"
            if [ -f "$R2_CHECK" ]; then R2="$R2_CHECK"; fi
        elif [[ "$R1" == *"_R1.fastq.gz" ]]; then
            R2_CHECK="${{R1/_R1.fastq.gz/_R2.fastq.gz}}"
            if [ -f "$R2_CHECK" ]; then R2="$R2_CHECK"; fi
        fi
        
        OUT_R1="{output.cleaned}"
        OUT_R2="${{OUT_R1/_1.fastq.gz/_2.fastq.gz}}"
        
        echo "Running fastp with CholeraSeq parameters (Q20, Window 4, Len 35) [Tier: {params.memory_tier}]..." >> {log}
        
        if [ -n "$R2" ]; then
            fastp -i "$R1" -I "$R2" \
                  -o "$OUT_R1" -O "$OUT_R2" \
                  -q 20 -W 4 -l 35 \
                  -j {output.json} -h {output.html} \
                  -w {threads} \
                  2>> {log}
        else
            fastp -i "$R1" \
                  -o "$OUT_R1" \
                  -q 20 -W 4 -l 35 \
                  -j {output.json} -h {output.html} \
                  -w {threads} \
                  2>> {log}
        fi
        """

# Rule 1: Remove human DNA contamination with Hostile
rule hostile_clean:
    input:
        fastq=rules.fastp_qc.output.cleaned
    output:
        cleaned="{output_dir}/{{sample}}/01_hostile/{{sample}}_clean.fastq.gz".format(
            output_dir=config["output_dir"]
        ),
        stats="{output_dir}/{{sample}}/01_hostile/stats.json".format(
            output_dir=config["output_dir"]
        )
    params:
        outdir=lambda wildcards, output: os.path.dirname(output.cleaned)
    threads: 1
    log:
        "{output_dir}/{{sample}}/logs/hostile.log".format(output_dir=config["output_dir"])
    shell:
        """
        set -euo pipefail
        mkdir -p {params.outdir}
        
        # Passthrough mode for faster testing - skip decontamination
        echo "⚠️ Skipping decontamination for faster testing. Passing raw data." >> {log}
        cp {input.fastq} {output.cleaned}
        echo '{{"stage": "hostile", "method": "passthrough", "success": true}}' > {output.stats}
        """




# Rule 2: Taxonomic classification with Kraken2
rule kraken2_classify:
    input:
        fastq=rules.hostile_clean.output.cleaned
    output:
        kraken_out="{output_dir}/{{sample}}/02_kraken2/kraken_output.txt".format(
            output_dir=config["output_dir"]
        ),
        kraken_report="{output_dir}/{{sample}}/02_kraken2/kraken_report.txt".format(
            output_dir=config["output_dir"]
        )
    params:
        db=get_adaptive_kraken_db,
        outdir=lambda wildcards, output: os.path.dirname(output.kraken_out),
        memory_tier=get_memory_tier
    threads: get_adaptive_threads
    conda:
        "envs/kraken2.yaml"
    log:
        "{output_dir}/{{sample}}/logs/kraken2.log".format(output_dir=config["output_dir"])
    shell:
        """
        mkdir -p {params.outdir}
        
        echo "Running Kraken2 classification [Tier: {params.memory_tier}]..." > {log}
        
        kraken2 \
            --db {params.db} \
            --threads {threads} \
            --output {output.kraken_out} \
            --report {output.kraken_report} \
            --gzip-compressed \
            {input.fastq} \
            2>&1 | tee -a {log}
        """

