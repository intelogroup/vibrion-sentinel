"""
Vibrion Sentinel Pipeline: Snakemake Workflow
CDC-compliant cholera surveillance for Haiti
"""

import os
import json
import sys

configfile: "workflow/config/config.yaml"

# Initialize memory manager for adaptive resource allocation
sys.path.insert(0, 'workflow')
from memory_manager import initialize_memory_manager, get_memory_manager

# Initialize on config load
memory_manager = initialize_memory_manager(config)

# ============================================================================
# Memory-Aware Helper Functions
# ============================================================================

def get_memory_tier(wildcards=None):
    """Get current memory tier."""
    mm = get_memory_manager()
    return mm.current_tier if mm else 'BALANCED'

def get_adaptive_threads(wildcards=None):
    """Get thread count based on memory tier."""
    mm = get_memory_manager()
    if mm:
        tier_config = mm.get_config_for_tier()
        return tier_config.get('threads', config.get('threads', 4))
    return config.get('threads', 4)

def get_adaptive_kraken_db(wildcards=None):
    """Get Kraken2 database based on memory tier."""
    mm = get_memory_manager()
    if mm:
        tier_config = mm.get_config_for_tier()
        return tier_config.get('kraken_db', config.get('kraken_db'))
    return config.get('kraken_db')

def get_adaptive_kraken_broad_db(wildcards=None):
    """Get broad Kraken2 database based on memory tier."""
    mm = get_memory_manager()
    if mm:
        tier_config = mm.get_config_for_tier()
        # In EMERGENCY mode, skip broad audit entirely
        if get_memory_tier() == 'EMERGENCY':
            return None  # Signal to skip this rule
        # In BUNKER mode, still use haiti_custom
        return tier_config.get('kraken_db', config.get('kraken_broad_db', 'data/kraken2_standard_8gb'))
    return config.get('kraken_broad_db', 'data/kraken2_standard_8gb')

def should_run_phylogeny():
    """Check if phylogenetic analysis should run."""
    mm = get_memory_manager()
    if mm:
        return mm.should_run_feature('mafft_full_alignment') or mm.should_run_feature('mafft_fast_alignment')
    return True

def should_run_evo2():
    """Check if EVO2 analysis should run."""
    mm = get_memory_manager()
    if mm:
        return mm.should_run_feature('evo2_pathogenicity')
    return True

def get_mafft_max_refs():
    """Get max references for MAFFT based on memory tier."""
    mm = get_memory_manager()
    if mm:
        tier_config = mm.get_config_for_tier()
        max_refs = tier_config.get('mafft_max_refs')
        if max_refs is None:
            return 999  # No limit
        return max(max_refs, 0)  # At least 0
    return 999

def log_memory_status(sample_id: str):
    """Log memory manager status for pipeline diagnostics."""
    mm = get_memory_manager()
    if mm:
        summary = mm.get_memory_summary()
        summary['sample'] = sample_id
        mm.write_memory_profile(sample_id)

def select_reference(wildcards):
    """
    Reference Switchboard (Haiti-focused): Prioritizes Haiti references, then global search.
    Hierarchy: Haiti 2010/2022 (≥0.99) → O139 → Global best match (≥0.98) → Haiti 2010 fallback
    """
    # Force triage and regional selection to run first
    checkpoints.strain_triage.get(**wildcards)
    checkpoints.global_reference_triage.get(**wildcards)
    
    output_dir = config.get("output_dir", "data/pipeline_output")
    match_path = f"{output_dir}/{wildcards.sample}/07_triage/regional_selection.json"
    
    if os.path.exists(match_path):
        with open(match_path) as f:
            match_data = json.load(f)
        
        all_sims = match_data.get("all_similarities", {})
        haiti_threshold = 0.99  # High confidence for Haiti assignment
        global_threshold = 0.98  # Minimum for non-Haiti references
        
        # Priority 1: Check Haiti references first (2010 or 2022)
        haiti_2010_sim = all_sims.get("2010EL-1786", 0)
        haiti_2022_sim = all_sims.get("Haiti_2022_Resurgence", 0)
        
        if haiti_2010_sim >= haiti_threshold or haiti_2022_sim >= haiti_threshold:
            # Use the better Haiti reference
            if haiti_2022_sim >= haiti_2010_sim:
                ref = "data/references/Haiti_2022_Resurgence.fasta"
                print(f"🇭🇹 [select_reference] Sample {wildcards.sample} → Haiti 2022 (similarity: {haiti_2022_sim:.3f})")
            else:
                ref = "data/references/2010EL-1786.fasta"
                print(f"🇭🇹 [select_reference] Sample {wildcards.sample} → Haiti 2010 (similarity: {haiti_2010_sim:.3f})")
            return ref
        
        # Priority 2: Check for O139 (non-O1 pathogen)
        decision_path = f"{output_dir}/{wildcards.sample}/07_triage/triage_decision.json"
        if os.path.exists(decision_path):
            with open(decision_path) as f:
                decision = json.load(f)
            if "O139" in decision.get("serogroup", ""):
                o139_ref = "data/serogroup_reference/clusters/LC594838.1_O139.fasta"
                if os.path.exists(o139_ref):
                    print(f"🦠 [select_reference] Sample {wildcards.sample} → O139 reference")
                    return o139_ref
        
        # Priority 3: Use global best match if high confidence (likely imported strain)
        best_ref = match_data.get("best_reference", "")
        best_sim = match_data.get("similarity", 0)
        
        if best_sim >= global_threshold:
            print(f"🌍 [select_reference] Sample {wildcards.sample} → {best_ref} (global match: {best_sim:.3f}, likely imported strain)")
            return best_ref
        
        # Priority 4: Low confidence - default to Haiti 2010 baseline
        print(f"⚠️ [select_reference] Sample {wildcards.sample} low similarity ({best_sim:.3f}) → defaulting to Haiti 2010 baseline")
        return "data/references/2010EL-1786.fasta"
    
    # Fallback if triage file missing
    print(f"⚠️ [select_reference] No triage data for {wildcards.sample}. Defaulting to Haiti 2010.")
    return "data/references/2010EL-1786.fasta"

