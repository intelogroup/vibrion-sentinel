# Rule 8d: Tier 1-2 - Local AI Triage (HyenaDNA Unified Cascade)
rule local_triage:
    input:
        tier0_json=rules.sourmash_divergence.output.tier0_json,
        sample_fasta=rules.polish_consensus.output.polished,
        ref_fasta="data/references/2010EL-1786.fasta",
