"""
Vibrion Sentinel Pipeline: Snakemake Workflow
CDC-compliant cholera surveillance for Haiti
"""

import os

configfile: "workflow/config/config.yaml"

# Wildcard constraints
wildcard_constraints:
    sample="[A-Za-z0-9_]+"

# Target rule - what we want to produce
rule all:
    input:
        expand(
            "{output_dir}/{sample}/08_comprehensive_report/surveillance_report.md",
            output_dir=config["output_dir"],
            sample=config["samples"]
        ),
        expand(
            "{output_dir}/{sample}/07_triage/triage_decision.json",
            output_dir=config["output_dir"],
            sample=config["samples"]
        )

# Rule 1: Remove human DNA contamination with Hostile
rule hostile_clean:
    input:
        fastq="{samples_dir}/{{sample}}.fastq.gz".format(samples_dir=config["samples_dir"])
    output:
        cleaned="{output_dir}/{{sample}}/01_hostile/{{sample}}_clean.fastq.gz".format(
            output_dir=config["output_dir"]
        ),
        stats="{output_dir}/{{sample}}/01_hostile/stats.json".format(
            output_dir=config["output_dir"]
        )
    params:
        outdir=lambda wildcards, output: os.path.dirname(output.cleaned),
        index=config["hostile_index"]
    threads: config["threads"]
    conda:
        "envs/hostile.yaml"
    log:
        "{output_dir}/{{sample}}/logs/hostile.log".format(output_dir=config["output_dir"])
    shell:
        """
        mkdir -p {params.outdir}
        
        if command -v hostile >/dev/null 2>&1; then
            echo "✅ Hostile found. Running primary decontamination..."
            hostile clean \
                --fastq1 {input.fastq} \
                --output {params.outdir} \
                --threads {threads} \
                --index {params.index} \
                2>&1 | tee {log}
            
            # Find the output file (Hostile adds suffixes)
            mv {params.outdir}/*clean*.fastq.gz {output.cleaned} 2>/dev/null || true
        elif command -v minimap2 >/dev/null 2>&1 && [ -f data/references/human.mmi ]; then
            echo "⚠️ Hostile missing. Using Minimap2 fallback (Biological Reverse Selection)..."
            minimap2 -ax sr -t {threads} data/references/human.mmi {input.fastq} 2>> {log} | \
                samtools fastq -f 4 - 2>> {log} | gzip -c > {output.cleaned}
        else
            echo "🚨 WARNING: No decontamination tools or indices found. PASSING RAW DATA (NOT RECOMMENDED)."
            cp {input.fastq} {output.cleaned}
        fi
        
        # Create stats JSON
        echo '{{"stage": "hostile", "input": "{input.fastq}", "output": "{output.cleaned}", "fallback": "'$(command -v hostile || echo minimap2)'"}}' > {output.stats}
        """

# Rule 2: Taxonomic classification with Kraken2
rule kraken2_classify:
    input:
        fastq=rules.hostile_clean.output.cleaned
    output:
        kraken_out="{output_dir}/{{sample}}/02_kraken2/kraken_output.txt".format(
            output_dir=config["output_dir"]
        ),
        kraken_report="{output_dir}/{{sample}}/02_kraken2/kraken_report.txt".format(
            output_dir=config["output_dir"]
        )
    params:
        db=config["kraken_db"],
        outdir=lambda wildcards, output: os.path.dirname(output.kraken_out)
    threads: config["threads"]
    conda:
        "envs/kraken2.yaml"
    log:
        "{output_dir}/{{sample}}/logs/kraken2.log".format(output_dir=config["output_dir"])
    shell:
        """
        mkdir -p {params.outdir}
        
        kraken2 \
            --db {params.db} \
            --threads {threads} \
            --output {output.kraken_out} \
            --report {output.kraken_report} \
            --gzip-compressed \
            {input.fastq} \
            2>&1 | tee {log}
        """

# Rule 3: Extract Vibrio reads only
rule extract_vibrio:
    input:
        kraken_out=rules.kraken2_classify.output.kraken_out,
        fastq=rules.hostile_clean.output.cleaned
    output:
        vibrio_fastq="{output_dir}/{{sample}}/03_vibrio/{{sample}}_vibrio_only.fastq.gz".format(
            output_dir=config["output_dir"]
        ),
        stats="{output_dir}/{{sample}}/03_vibrio/stats.json".format(
            output_dir=config["output_dir"]
        )
    params:
        taxid=config["vibrio_taxid"],
        outdir=lambda wildcards, output: os.path.dirname(output.vibrio_fastq)
    conda:
        "envs/analysis.yaml"
    log:
        "{output_dir}/{{sample}}/logs/extract_vibrio.log".format(output_dir=config["output_dir"])
    script:
        "scripts/extract_vibrio.py"

# Rule 3a: Extract unclassified reads for EVO2 rescue
rule extract_unclassified:
    input:
        kraken_out=rules.kraken2_classify.output.kraken_out,
        fastq=rules.hostile_clean.output.cleaned
    output:
        unclassified="{output_dir}/{{sample}}/03_rescue/{{sample}}_unclassified.fastq.gz".format(
            output_dir=config["output_dir"]
        )
    params:
        outdir=lambda wildcards, output: os.path.dirname(output.unclassified)
    conda:
        "envs/analysis.yaml"
    log:
        "{output_dir}/{{sample}}/logs/extract_unclassified.log".format(output_dir=config["output_dir"])
    script:
        "scripts/extract_unclassified.py"

# Rule 3b: [DISABLED] Embed Vibrio reference genome using EVO2 (Slow local CPU version)
# rule embed_reference:
