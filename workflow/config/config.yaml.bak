# Vibrion Pipeline Configuration
samples_dir: data/raw_reads
output_dir: data/pipeline_output
reference_dir: data/references
global_references_dir: data/global_references
reference_library_dir: data/reference_library
global_lineages:
  [
    "haiti-2010",
    "haiti-2022",
    "malawi-2023",
    "yemen-2017",
    "india-wave3",
    "bangladesh-xdr-2023",
    "peru-wasa",
    "mexico-endemic",
    "nepal-2010",
    "nigeria-2023",
    "drc-2023",
    "ecoli-k12",
    "v-parahaemolyticus",
    "novc-decoy",
  ]

# NOVC Environmental Reference Library (for contamination/environmental detection)
novc_references_enabled: True
novc_reference_dir: data/reference_library/novc_environmental
novc_reference_strains:
  - NOVC13  # Most recent, Nanjing CDC
  - NOVC03  # Environmental isolate, Nanjing CDC
  - NOVC05  # Environmental isolate, Nanjing CDC
  - RFB16   # Lake environmental isolate, USA
  - NOVC07  # Environmental isolate, Nanjing CDC

# Tier 1: Kraken2 (Fast k-mer filter)
kraken_db: data/kraken2_haiti_custom # Specialist: Haiti Vibrio + Decoys
kraken_broad_db: data/kraken2_standard_8gb # Generalist: RefSeq Bacteria/Virus
serogroup_db: data/kraken2_serogroup

# Tier 2: Deep Rescue (MMseqs2 - Mutation Tolerant)
mmseqs_db: data/mmseqs_db/swissprot
mmseqs_min_seq_id: 0.8 # Lower identity for mutated rescue
mmseqs_mapping_rescue_enabled: True
mapping_rescue_confidence_threshold: 0.6
mapping_rescue_max_reads: 5000

# Variant Calling & Heterogeneity Thresholds
variant_thresholds:
  clonal_af: 0.9       # AF >= 0.9 is considered a fixed clonal mutation
  minor_af: 0.1        # AF >= 0.1 is reported in the minor variant VCF
  hetero_min_depth: 20 # Minimum depth required to call heterogeneity (higher than standard)
  iupac_min_af: 0.2    # AF threshold to trigger IUPAC ambiguity code in consensus

# Alignment Configuration
# Options: 'bwa' (Illumina/Short Read), 'minimap2' (PacBio/Nanopore/Structural)
aligner_type: "bwa"
# Tier 3: Pre-Filter + Evo2 (Specialist pathogenicity analysis)
snpeff_db: Vibrio_cholerae_o1_str_2010el_1786 # Matches 2010EL-1786 reference

# Consensus generation mode
pipeline_mode: "LABORATORY_FULL" # or "FIELD_RAPID"
# AI API Configuration (NVIDIA BioNeMo)
nvidia_api_key: "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"
evo_api_url: "https://health.api.nvidia.com/v1/biology/arc/evo2-40b/generate"

# Evolution Surveillance Benchmarks
evo2:
  sentinel_ref: "data/references/2010EL-1786.fasta"
  outbreak_ref: "data/references/Haiti_2022_Resurgence.fasta"
  # Pre-extracted loci for baseline comparisons
  sentinel_loci: "{output_dir}/{{sample}}/05_loci/reference_loci.fasta"
  outbreak_loci: "data/references/Haiti_2022_loci.fasta"

# Local Triage Configuration (Synergistic Bunker Mode)
triage:
  # Model cache directory
  model_cache_dir: "data/models/triage"

  # Tier 0: sourmash k-mer sketching
  sourmash_ksize: 31
  sourmash_scaled: 1000
  sourmash_threshold: 0.999 # Jaccard similarity (99.9% = routine)
  sourmash_min_divergent_kmers: 10 # Min divergent k-mers to cascade to Tier 1

  # Tier 1: HyenaDNA focused scan
  hyena_model: "LongSafari/hyenadna-tiny-1k-seqlen-hf" # Using downloaded tiny model
  hyena_threshold: 4.0 # Perplexity threshold (>4.0 = anomaly). Lowered from 15.0 to close safety gap.
  hyena_window_size: 500 # Window size (bp) around divergent k-mers
  hyena_use_real_model: true # Set to false to use prototype logic

  # Tier 2: HyenaDNA locus-level verification (unified model, no additional dependencies)
  hyenadna_tier2_model: "LongSafari/hyenadna-tiny-1k-seqlen-hf" # Reuse HyenaDNA for locus scoring
  hyenadna_tier2_loci: ["ctxB", "wbeT", "tcpA", "gyrA", "parE", "scrABC", "katB", "ahpC", "hapR"]
  hyenadna_tier2_threshold: 2.0 # Locus variance threshold (>2.0 = high risk structural change)
  hyenadna_tier2_overlap_threshold: 0.5 # Min gene overlap with anomaly windows (deprecated with new method)
  hyenadna_tier2_use_real_model: true # Uses HyenaDNA for both Tier 1 and Tier 2

  # Device for inference
  device: "mps" # Use "mps" for Mac M1/M2, "cuda" for GPU, "cpu" for CPU

# Memory Management System (Adaptive, Non-blocking, Graceful Degradation)
memory_management:
  enabled: True
  # Automatic tier selection based on available system RAM
  auto_detect: True
  # Force specific tier (if auto_detect: False): FULL, BALANCED, BUNKER, EMERGENCY
  force_tier: null
  
  tiers:
    FULL:
      available_gb_min: 10
      description: "All features enabled (standard production mode)"
      kraken_db: "data/kraken2_standard_8gb"  # Full RefSeq database
      max_threads: 4
      features:
        - kraken2_full
        - mmseqs2_rescue
        - mafft_full_alignment
        - evo2_pathogenicity
        - phylogenetic_inference
      memory_settings:
        kraken2_threads: 4
        spades_kmers: "21,33,55,77"  # Full k-mer range
        mafft_strategy: "full"  # All references
        mafft_max_refs: null  # No limit
    
    BALANCED:
      available_gb_min: 6
      description: "Optimized for typical laptops (Haiti custom + selective alignment)"
      kraken_db: "data/kraken2_haiti_custom"  # Specialized 1GB database
      max_threads: 3
      features:
        - kraken2_haiti
        - mmseqs2_rescue
        - mafft_fast_alignment
        - evo2_pathogenicity
      memory_settings:
        kraken2_threads: 3
        spades_kmers: "21,33,55"  # Reduced k-mers
        mafft_strategy: "fast"  # Top 50 references only
        mafft_max_refs: 50
    
    BUNKER:
      available_gb_min: 3
      description: "Minimal footprint for resource-constrained environments"
      kraken_db: "data/kraken2_haiti_custom"
      max_threads: 2
      features:
        - kraken2_haiti
        - mmseqs2_rescue  # Protein-level is efficient
      memory_settings:
        kraken2_threads: 2
        spades_kmers: "21,33"  # Minimal k-mers
        mafft_strategy: "skip"  # Skip phylogenetic alignment (use MMseqs2 hits only)
        mafft_max_refs: 0
    
    EMERGENCY:
      available_gb_min: 0
      description: "Core analysis only (critical infrastructure deployments)"
      kraken_db: "data/kraken2_haiti_custom"
      max_threads: 1
      features:
        - kraken2_haiti  # Classification only
      memory_settings:
        kraken2_threads: 1
        spades_assembly: false  # Skip assembly entirely
        mafft_strategy: "skip"
  
  # Monitoring configuration (non-blocking, informational only)
  monitoring:
    enabled: True
    check_interval_sec: 30  # Check every 30 seconds
    log_file: "logs/memory_profile.log"
    alert_threshold_percent: 85  # Warn at 85% usage
  
  # Cleanup configuration (suggestions only, never automatic)
  cleanup:
    enable_suggestions: True
    auto_cleanup: False  # Always False: manual review required

# General settings
hostile_index: human-t2t-hla-argos985
vibrio_taxid: 662
threads: 4
memory_mb: 8000
samples:
  ["SRR22265437", "SRR22265446", "Bangladesh_O139_Challenge", "SRR30566858", "SRR23509871"]
